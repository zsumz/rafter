{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zsumz/rafter/verification/invariant-result-schema.json",
  "title": "Rafter invariant evidence result bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runner", "profile", "source_ref", "execution", "results"],
  "properties": {
    "schema_version": { "const": 14 },
    "runner": { "enum": ["tests", "simulator", "tla", "maelstrom"] },
    "profile": { "enum": ["pr", "nightly", "weekly"] },
    "source_ref": { "type": "string", "minLength": 1 },
    "execution": { "$ref": "#/$defs/execution" },
    "results": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "invocation", "producer", "source", "checks", "duration_ms", "peak_rss_kib", "artifacts"],
      "properties": {
        "plan": { "$ref": "#/$defs/plan" },
        "invocation": { "$ref": "#/$defs/invocation" },
        "producer": { "$ref": "#/$defs/producer_binding" },
        "source": { "$ref": "#/$defs/source" },
        "checks": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/check" } },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "peak_rss_kib": { "type": "integer", "minimum": 1 },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "plan_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "registry", "manifest", "result_schema", "verdict_schema", "contract"],
      "properties": {
        "schema_version": { "const": 3 },
        "profile": { "enum": ["pr", "nightly", "weekly"] },
        "registry": { "$ref": "#/$defs/plan_input" },
        "manifest": { "$ref": "#/$defs/plan_input" },
        "result_schema": { "$ref": "#/$defs/plan_input" },
        "verdict_schema": { "$ref": "#/$defs/plan_input" },
        "contract": { "$ref": "#/$defs/profile_contract" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "program_sha256", "arguments", "current_dir", "environment", "environment_sha256", "launchers"],
      "properties": {
        "program": { "type": "string", "minLength": 1 },
        "program_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "current_dir": { "type": "string", "minLength": 1 },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "launchers": {
          "type": "array",
          "items": { "$ref": "#/$defs/launcher" }
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "runtime", "program", "sha256"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "producer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "executable"],
      "properties": {
        "binding": { "const": "immutable-reexec-v1" },
        "executable": { "$ref": "#/$defs/artifact" }
      }
    },
    "profile_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "evidence_policy", "clause_policy", "required_clause_strength", "required_layers", "required_strengths", "canonical_minimum_independent_layers", "runners"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "evidence_policy": { "const": "all_matching_registry_evidence" },
        "clause_policy": { "const": "all_required_clauses" },
        "required_clause_strength": { "const": "direct" },
        "required_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["tests", "simulator", "tla", "maelstrom"] }
        },
        "required_strengths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["direct", "e2e"] }
        },
        "canonical_minimum_independent_layers": { "type": "integer", "minimum": 2 },
        "runners": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["tests", "simulator", "tla", "maelstrom"] },
          "additionalProperties": { "$ref": "#/$defs/runner_contract" }
        }
      }
    },
    "runner_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "command", "configuration", "minimum_observed_checks", "require_peak_rss"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "configuration": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "simulator_checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/simulator_check_contract" }
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/proof_obligation_contract" }
        },
        "minimum_observed_checks": { "type": "integer", "minimum": 1 },
        "require_peak_rss": { "type": "boolean" }
      }
    },
    "tla_continuation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "outcome"],
      "properties": {
        "policy": { "enum": ["gating-frontier-exhausted", "reporting-continuation"] },
        "outcome": { "enum": ["frontier-exhausted", "counterexample", "budget-elapsed-frontier-open"] }
      }
    },
    "proof_obligation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "config",
        "completion",
        "minimum_generated_states",
        "minimum_distinct_states",
        "soft_timeout",
        "seed"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "config": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.cfg$" },
        "completion": { "const": "frontier-exhausted" },
        "minimum_generated_states": { "type": "integer", "minimum": 1 },
        "minimum_distinct_states": { "type": "integer", "minimum": 1 },
        "soft_timeout": { "type": "string", "pattern": "^[1-9][0-9]*m$" },
        "seed": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "simulator_check_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_protocol_states", "minimum_verifier_states", "required_observations"],
      "properties": {
        "minimum_protocol_states": { "type": "integer", "minimum": 1 },
        "minimum_verifier_states": { "type": "integer", "minimum": 1 },
        "required_observations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
        }
      }
    },
    "test_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "target_kind", "target", "test_name"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "target_kind": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "test_name": { "type": "string", "minLength": 1 }
      }
    },
    "simulator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "required_observation", "minimum_observation"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_observation": { "type": "string", "minLength": 1 },
        "minimum_observation": { "type": "integer", "minimum": 1 },
        "minimum_protocol_states": { "type": "integer", "minimum": 1 },
        "minimum_verifier_states": { "type": "integer", "minimum": 1 },
        "minimum_runs_per_check": { "type": "integer", "minimum": 1 },
        "minimum_steps": { "type": "integer", "minimum": 1 },
        "liveness_report": { "$ref": "#/$defs/simulator_liveness_contract" },
        "negative_test": { "$ref": "#/$defs/test_identity" }
      },
      "anyOf": [
        { "required": ["minimum_protocol_states", "minimum_verifier_states"] },
        { "required": ["minimum_runs_per_check", "minimum_steps", "liveness_report"] }
      ]
    },
    "simulator_liveness_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id", "clause_ids", "feature_id", "scenario_id", "observation_id",
        "fault_requirement", "stable_leader_retained", "stable_leader_rounds_minimum",
        "stable_leader_rounds_exact", "stable_leader_rounds_relation", "proposal_outcome",
        "authority_loss_required", "fault_cycle_required", "fairness_policy_id",
        "fairness_tick_bound_rounds", "fairness_delivery_bound_rounds",
        "fairness_max_delivery_waves_per_tick", "round_budget_provenance",
        "minimum_rounds", "rounds_per_node", "rounds_per_queued_message",
        "rounds_per_proposal", "rounds_per_membership_change", "rounds_per_partition",
        "snapshot_catchup_rounds", "phase_count", "fixed_rounds"
      ],
      "properties": {
        "invariant_id": { "type": "string", "pattern": "^LV-[0-9]{2}$" },
        "clause_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^LV-[0-9]{2}\\.[a-z]$" } },
        "feature_id": { "type": "string", "minLength": 1 },
        "scenario_id": { "type": "string", "minLength": 1 },
        "observation_id": { "type": "string", "minLength": 1 },
        "fault_requirement": { "enum": ["stopped", "active-partition"] },
        "stable_leader_retained": { "type": ["boolean", "null"] },
        "stable_leader_rounds_minimum": { "type": ["integer", "null"], "minimum": 1 },
        "stable_leader_rounds_exact": { "type": ["integer", "null"], "minimum": 1 },
        "stable_leader_rounds_relation": { "enum": ["none", "exact", "probe-rounds"] },
        "proposal_outcome": { "enum": ["none", "committed", "explicit-terminal"] },
        "authority_loss_required": { "type": "boolean" },
        "fault_cycle_required": { "type": "boolean" },
        "fairness_policy_id": { "const": "seeded-rotating-all-node-ticks-ready-wave-permutations-v1" },
        "fairness_tick_bound_rounds": { "type": "integer", "minimum": 1 },
        "fairness_delivery_bound_rounds": { "type": "integer", "minimum": 1 },
        "fairness_max_delivery_waves_per_tick": { "type": "integer", "minimum": 1 },
        "round_budget_provenance": { "const": "liveness-round-budget-v1" },
        "minimum_rounds": { "type": "integer", "minimum": 1 },
        "rounds_per_node": { "type": "integer", "minimum": 1 },
        "rounds_per_queued_message": { "type": "integer", "minimum": 1 },
        "rounds_per_proposal": { "type": "integer", "minimum": 1 },
        "rounds_per_membership_change": { "type": "integer", "minimum": 1 },
        "rounds_per_partition": { "type": "integer", "minimum": 1 },
        "snapshot_catchup_rounds": { "type": "integer", "minimum": 1 },
        "phase_count": { "type": "integer", "minimum": 1 },
        "fixed_rounds": { "type": "integer", "minimum": 0 }
      }
    },
    "simulator_execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id", "profile_id", "check_id", "check_kind", "node_config_id",
        "node_count", "steps", "max_proposals", "max_restarts", "max_read_indexes",
        "max_membership_changes", "max_transfers", "max_partitions", "max_lossy_restarts",
        "snapshot_catchup_probe", "tick_skew_node_id", "tick_skew_weight"
      ],
      "properties": {
        "contract_id": { "const": "rafter-soak-execution-v1" },
        "profile_id": { "enum": ["raft-soak", "raft-nightly-soak", "raft-weekly-soak"] },
        "check_id": { "type": "string", "minLength": 1 },
        "check_kind": { "enum": ["standard", "lease", "membership"] },
        "node_config_id": { "enum": ["three-node-standard-v1", "three-node-lease-v1", "four-node-future-learner-v1"] },
        "node_count": { "type": "integer", "minimum": 1 },
        "steps": { "type": "integer", "minimum": 1 },
        "max_proposals": { "type": "integer", "minimum": 0 },
        "max_restarts": { "type": "integer", "minimum": 0 },
        "max_read_indexes": { "type": "integer", "minimum": 0 },
        "max_membership_changes": { "type": "integer", "minimum": 0 },
        "max_transfers": { "type": "integer", "minimum": 0 },
        "max_partitions": { "type": "integer", "minimum": 0 },
        "max_lossy_restarts": { "type": "integer", "minimum": 0 },
        "snapshot_catchup_probe": { "type": "boolean" },
        "tick_skew_node_id": { "type": ["integer", "null"], "minimum": 1 },
        "tick_skew_weight": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "simulator_liveness_report_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "seed", "execution_contract", "execution_contract_sha256", "report_sha256", "round_limit", "rounds_used"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "execution_contract": { "$ref": "#/$defs/simulator_execution_contract" },
        "execution_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "round_limit": { "type": "integer", "minimum": 1 },
        "rounds_used": { "type": "integer", "minimum": 0 }
      }
    },
    "simulator_liveness_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract", "contract_sha256", "reports_sha256", "reports"],
      "properties": {
        "schema_version": { "const": 1 },
        "contract": { "$ref": "#/$defs/simulator_liveness_contract" },
        "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reports_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/simulator_liveness_report_binding" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "materialization", "cargo_lock_sha256", "cargo", "cargo_sha256", "cargo_config_sha256", "rustc", "rustc_sha256", "target", "build_profile", "features", "tools", "process_runtime", "environment_sha256", "clean"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "minLength": 1 },
        "materialization": { "$ref": "#/$defs/source_materialization" },
        "cargo_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cargo": { "type": "string", "minLength": 1 },
        "cargo_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cargo_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rustc": { "type": "string", "minLength": 1 },
        "rustc_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "target": { "type": "string", "minLength": 1 },
        "build_profile": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "tools": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/tool" }
        },
        "process_runtime": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": { "$ref": "#/$defs/executable" }
        },
        "environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "clean": { "const": true }
      }
    },
    "source_materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "sha256", "tracked_entries", "submodules"],
      "properties": {
        "contract": { "const": "git-head-worktree-raw-v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tracked_entries": { "type": "integer", "minimum": 1 },
        "submodules": { "const": 0 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "sha256"],
      "properties": {
        "program": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "check_id", "evidence_ids", "completion", "observations", "simulator_liveness", "duration_ms", "peak_rss_kib", "artifacts"],
      "properties": {
        "execution_id": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "completion": {
          "$comment": "Why the check stopped. Two of these are passes and they are not interchangeable. 'frontier_exhausted' means the search space was drained: 'states_left_on_queue' is 0 and the terminal counters are published. 'budget_elapsed_frontier_open' means a TLA+ reporting continuation spent its time budget with a healthy open frontier: it publishes the 'progress_*' counters instead, 'progress_states_left' is greater than 0, and the layer's verdict was carried by its proof obligations rather than by this run. Reading 'completion' alone is sufficient; 'tla_continuation' repeats the same fact in the TLA+ layer's own vocabulary and must agree with it.",
          "enum": ["completed", "frontier_exhausted", "counterexample", "coverage_not_reached", "budget_exhausted", "timeout", "harness_error", "budget_elapsed_frontier_open"]
        },
        "observations": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "tla_continuation": {
          "$comment": "TLA+ receipts only. 'policy' is pinned by the profile, not chosen by the producer. 'outcome' must agree with 'completion': 'budget-elapsed-frontier-open' pairs with 'budget_elapsed_frontier_open', 'frontier-exhausted' with 'frontier_exhausted', 'counterexample' with 'counterexample'.",
          "$ref": "#/$defs/tla_continuation_binding"
        },
        "simulator_liveness": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/simulator_liveness_binding" }
          ]
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "peak_rss_kib": { "type": "integer", "minimum": 1 },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size_bytes"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "evidence_id", "execution_id", "status"],
      "properties": {
        "invariant_id": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{2}$" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "execution_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "incomplete", "error"] },
        "classification": {
          "enum": ["invariant_violation", "coverage_not_reached", "harness_error"]
        },
        "message": { "type": "string" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pass" } } },
          "then": { "not": { "required": ["classification"] } }
        },
        {
          "if": { "properties": { "status": { "const": "fail" } } },
          "then": {
            "required": ["classification", "message", "artifacts"],
            "properties": { "classification": { "const": "invariant_violation" } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "incomplete" } } },
          "then": {
            "required": ["classification", "message", "artifacts"],
            "properties": { "classification": { "const": "coverage_not_reached" } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "error" } } },
          "then": {
            "required": ["classification", "message", "artifacts"],
            "properties": { "classification": { "const": "harness_error" } }
          }
        }
      ]
    }
  }
}
