{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zsumz/rafter/verification/invariant-verdict-schema.json",
  "title": "Rafter invariant verdict report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "source_ref", "summary", "artifacts", "invariants"],
  "properties": {
    "schema_version": { "const": 2 },
    "profile": { "enum": ["pr", "nightly", "weekly"] },
    "source_ref": { "type": "string", "minLength": 1 },
    "summary": { "$ref": "#/$defs/summary" },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "invariants": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/invariant" }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "green", "red"],
      "properties": {
        "total": { "const": 44 },
        "green": { "type": "integer", "minimum": 0, "maximum": 44 },
        "red": { "type": "integer", "minimum": 0, "maximum": 44 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size_bytes"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "status", "classification", "message"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["fail", "incomplete", "error"] },
        "classification": { "enum": ["invariant_violation", "coverage_not_reached", "harness_error"] },
        "message": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "fail" },
            "classification": { "const": "invariant_violation" }
          }
        },
        {
          "properties": {
            "status": { "const": "incomplete" },
            "classification": { "const": "coverage_not_reached" }
          }
        },
        {
          "properties": {
            "status": { "const": "error" },
            "classification": { "const": "harness_error" }
          }
        }
      ]
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "statement", "status", "required_evidence", "passed_evidence"],
      "properties": {
        "clause_id": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{2}\\.[a-z]$" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["green", "red"] },
        "required_evidence": { "type": "integer", "minimum": 0 },
        "passed_evidence": { "type": "integer", "minimum": 0 },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id", "status", "required_clauses", "passed_clauses",
        "required_evidence", "passed_evidence", "clauses"
      ],
      "properties": {
        "invariant_id": {
          "enum": [
            "ST-01",
            "EL-01", "EL-02", "EL-03", "EL-04", "EL-05", "EL-06", "EL-07", "EL-08",
            "LG-01", "LG-02", "LG-03", "LG-04", "LG-05",
            "CM-01", "CM-02", "CM-03",
            "AP-01", "AP-02",
            "MB-01", "MB-02", "MB-03", "MB-04", "MB-05", "MB-06", "MB-07",
            "RD-01", "RD-02", "RD-03", "RD-04", "RD-05", "RD-06",
            "PS-01", "PS-02", "PS-03", "PS-04",
            "SS-01", "SS-02", "SS-03", "SS-04", "SS-05",
            "LV-01", "LV-02", "LV-03"
          ]
        },
        "status": { "enum": ["green", "red"] },
        "required_clauses": { "type": "integer", "minimum": 1 },
        "passed_clauses": { "type": "integer", "minimum": 0 },
        "required_evidence": { "type": "integer", "minimum": 0 },
        "passed_evidence": { "type": "integer", "minimum": 0 },
        "clauses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clause" } },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    }
  }
}
