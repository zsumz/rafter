#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/maelstrom-lin-kv-common
source "${SCRIPT_DIR}/maelstrom-lin-kv-common"

rafter_maelstrom_require_tools
REPO_ROOT="$(rafter_maelstrom_repo_root "$SCRIPT_DIR")"
rafter_maelstrom_export_root
export RAFTER_MAELSTROM_MEMBERSHIP_PLAN="${RAFTER_MAELSTROM_MEMBERSHIP_PLAN:-remove-last-voter}"
TIME_LIMIT="${RAFTER_MAELSTROM_TIME_LIMIT:-20}"
RATE="${RAFTER_MAELSTROM_RATE:-100}"
CONCURRENCY="${RAFTER_MAELSTROM_CONCURRENCY:-8}"

cargo build --manifest-path "${REPO_ROOT}/Cargo.toml" -p rafter-maelstrom --bin rafter-maelstrom

maelstrom test \
  --workload lin-kv \
  --bin "${REPO_ROOT}/target/debug/rafter-maelstrom" \
  --node-count 4 \
  --time-limit "$TIME_LIMIT" \
  --rate "$RATE" \
  --concurrency "$CONCURRENCY" \
  --nemesis partition \
  --nemesis-interval 1 \
  "$@"
