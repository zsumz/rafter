#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="${RAFTER_MAELSTROM_SCRIPT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
# shellcheck source=scripts/maelstrom-lin-kv-common
source "${SCRIPT_DIR}/maelstrom-lin-kv-common"

rafter_maelstrom_require_tools
REPO_ROOT="$(rafter_maelstrom_repo_root "$SCRIPT_DIR")"
rafter_maelstrom_export_root
export RAFTER_MAELSTROM_CHILD="${RAFTER_MAELSTROM_CHILD:-${REPO_ROOT}/target/debug/rafter-maelstrom}"
export RAFTER_MAELSTROM_CRASH_AFTER_APP_PERSIST_ONCE=1
export RAFTER_MAELSTROM_RESTARTS="${RAFTER_MAELSTROM_RESTARTS:-0}"
export RAFTER_MAELSTROM_DOWN_MS="${RAFTER_MAELSTROM_DOWN_MS:-200}"
TIME_LIMIT="${RAFTER_MAELSTROM_TIME_LIMIT:-20}"
RATE="${RAFTER_MAELSTROM_RATE:-100}"
CONCURRENCY="${RAFTER_MAELSTROM_CONCURRENCY:-6}"

rafter_maelstrom_cargo_build -p rafter-maelstrom --bins

maelstrom test \
  --workload lin-kv \
  --bin "${REPO_ROOT}/target/debug/rafter-maelstrom-leader-restart-proxy" \
  --node-count 3 \
  --time-limit "$TIME_LIMIT" \
  --rate "$RATE" \
  --concurrency "$CONCURRENCY" \
  --nemesis partition \
  --nemesis-interval 1 \
  "$@"
