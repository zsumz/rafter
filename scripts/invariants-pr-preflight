#!/usr/bin/env python3
"""Check the full PR qualification budget and external tools before compiling."""

import hashlib
import json
import re
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# run-all executes layers sequentially. Reserve another hour for the initial
# build, final aggregation, subprocess cleanup, and receipt finalization.
ORCHESTRATION_RESERVE_SECONDS = 60 * 60


def seconds(value):
    match = re.fullmatch(r"(\d+)(s|m|h)", value)
    if not match:
        raise ValueError(f"unsupported qualification duration: {value}")
    return int(match[1]) * {"s": 1, "m": 60, "h": 3600}[match[2]]


def check_budget(root):
    profile = json.loads((root / "verification/raft-invariant-profiles.json").read_text())["profiles"]["pr"]
    manifest = tomllib.loads((root / "zcheck.toml").read_text())
    required = ORCHESTRATION_RESERVE_SECONDS
    for name in profile["required_layers"]:
        config = profile["runners"][name]["configuration"]
        required += seconds(config["total_timeout" if name == "tla" else "layer_timeout"])
    actual = seconds(manifest["tasks"]["invariants-pr"]["timeout"])
    if actual < required:
        raise ValueError(f"invariants-pr timeout is {actual // 60}m; needs at least {required // 60}m for all layers and finalization")
    return profile


def check_tools(root, profile):
    config = profile["runners"]["tla"]["configuration"]
    version = subprocess.run(["java", "-version"], capture_output=True, text=True, check=True)
    if not re.search(r'version "' + re.escape(config["java_major"]) + r'(?:[."]|$)', version.stdout + version.stderr):
        raise ValueError(f"Java {config['java_major']} is required for PR invariant evidence")
    # The source-bound producer reads this canonical path from its checkout.
    jar = root / "tools/cache/tla2tools.jar"
    if not jar.is_file():
        raise ValueError(f"install the pinned tla2tools.jar at {jar}; see docs/development.md")
    expected = config["tool_sha256"]
    checksum = (root / "tools/tla/SHA256SUMS").read_text().splitlines()
    if f"{expected}  tla2tools.jar" not in checksum:
        raise ValueError("TLA profile and tools/tla/SHA256SUMS disagree")
    if hashlib.sha256(jar.read_bytes()).hexdigest() != expected:
        raise ValueError("tla2tools.jar does not match the reviewed PR tool digest")


def main():
    if sys.argv[1:] not in ([], ["--budget-only"]):
        raise ValueError("usage: scripts/invariants-pr-preflight [--budget-only]")
    profile = check_budget(ROOT)
    if not sys.argv[1:]:
        check_tools(ROOT, profile)
    print("PR invariant qualification preflight passed")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        raise SystemExit(1) from error
