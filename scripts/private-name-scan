#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/private-name-scan [--include-assets] PATTERN...
       : "${RAFTER_PRIVATE_NAME_PATTERNS:?set patterns outside the repo}"
       scripts/private-name-scan

Scans release-facing text surfaces for private downstream names or other
private patterns. The default scan is intentionally text-aware: it covers
release markdown, manifests, Rust source, scripts, and workflows while
excluding binary or base64-heavy assets such as SVGs. Use --include-assets only
for a separate human-reviewed asset pass because encoded image data can produce
false positives.

"Release-facing" is defined by what a reader outside this project can obtain:
every file a package archive ships, plus every file a visitor to the repository
reads. That is why the scan covers each crate's own markdown, LICENSE, and
NOTICE -- scripts/reference-package-check requires those inside the published
archives, so a private name in one is published -- as well as RELEASE.md,
docs/, specs/, reference/, and bench-compare/. Widening this list is cheaper
than explaining a leak; narrowing it needs an argument about who cannot read
the file.
USAGE
}

include_assets=0
patterns=()

while (($#)); do
  case "$1" in
    --include-assets)
      include_assets=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      patterns+=("$1")
      shift
      ;;
  esac
done

if ((${#patterns[@]} == 0)) && [[ -n "${RAFTER_PRIVATE_NAME_PATTERNS:-}" ]]; then
  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    patterns+=("$pattern")
  done < <(printf '%s' "${RAFTER_PRIVATE_NAME_PATTERNS}" | tr ',;' '\n')
fi

clean_patterns=()
for pattern in "${patterns[@]}"; do
  pattern="${pattern#"${pattern%%[![:space:]]*}"}"
  pattern="${pattern%"${pattern##*[![:space:]]}"}"
  if [[ -n "$pattern" ]]; then
    clean_patterns+=("$pattern")
  fi
done
patterns=("${clean_patterns[@]}")

if ((${#patterns[@]} == 0)); then
  usage >&2
  echo >&2
  echo "private-name scan requires at least one pattern" >&2
  exit 2
fi

# The paths below are relative, so the scan must read this checkout rather than
# whatever directory it was invoked from. Without this, a run from elsewhere
# finds none of its targets and rg falls back to scanning the caller's tree,
# which reports a clean result about the wrong repository.
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

targets=(
  README.md
  RELEASE.md
  LICENSE
  NOTICE
  Cargo.toml
  Cargo.lock
  crates
  reference
  docs
  specs
  fuzz
  bench-compare
  scripts
  .github
)

globs=(
  --glob 'README.md'
  --glob 'RELEASE.md'
  --glob 'LICENSE'
  --glob 'NOTICE'
  --glob 'Cargo.toml'
  --glob 'Cargo.lock'
  # Each publishable crate ships its own README, format documents, LICENSE, and
  # NOTICE inside its archive; the root copies never reach one.
  --glob 'crates/**/*.rs'
  --glob 'crates/**/Cargo.toml'
  --glob 'crates/**/*.md'
  --glob 'crates/**/LICENSE'
  --glob 'crates/**/NOTICE'
  --glob 'reference/**/*.rs'
  --glob 'reference/**/Cargo.toml'
  --glob 'reference/**/*.md'
  --glob 'docs/**'
  --glob 'specs/**'
  --glob 'fuzz/**/*.rs'
  --glob 'fuzz/**/Cargo.toml'
  --glob 'bench-compare/**/*.rs'
  --glob 'bench-compare/**/Cargo.toml'
  --glob 'bench-compare/**/*.md'
  --glob 'scripts/**'
  --glob '.github/**'
  # A glob given on the command line outranks .gitignore in ripgrep, so the
  # includes above pull generated output back in -- `Cargo.lock` matches that
  # basename at any depth, and `reference/**/*.md` matches rustdoc's bundled
  # font licences. Exclude the build directories by name. Each pattern
  # contains a slash, which anchors it to this checkout's root, so the
  # hand-written module at crates/rafter-invariants/src/verification/target/
  # keeps being scanned.
  --glob '!target/**'
  --glob '!crates/*/target/**'
  --glob '!reference/target/**'
  --glob '!bench-compare/target/**'
  --glob '!fuzz/target/**'
)

if ((include_assets)); then
  echo "warning: asset scan is enabled; review base64/binary-looking matches manually" >&2
  targets+=(rafter-logo.svg)
else
  globs+=(
    --glob '!*.svg'
    --glob '!*.png'
    --glob '!*.jpg'
    --glob '!*.jpeg'
    --glob '!*.gif'
    --glob '!*.webp'
    --glob '!*.ico'
  )
fi

existing_targets=()
for target in "${targets[@]}"; do
  if [[ -e "$target" ]]; then
    existing_targets+=("$target")
  fi
done

matched=0
for pattern in "${patterns[@]}"; do
  if rg --fixed-strings --line-number --color never "${globs[@]}" -- "$pattern" "${existing_targets[@]}"; then
    matched=1
  fi
done

if ((matched)); then
  echo "private-name scan found matches" >&2
  exit 1
fi

echo "private-name scan found no matches across text release surfaces"
