#!/usr/bin/env bash
# Verify and run the exact Unix ledger publication process-loss matrix.
# Usage: scripts/reference-ledger-publication [--list-only]
set -euo pipefail

list_only=()
case "$#:${1:-}" in
    0:) ;;
    1:--list-only) list_only=(--list-only) ;;
    *)
        echo "usage: scripts/reference-ledger-publication [--list-only]" >&2
        exit 2
        ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
patch_file="$(mktemp "${TMPDIR:-/tmp}/rafter-ledger-publication-patch.XXXXXX")"
trap 'rm -f "$patch_file"' EXIT
"${repo_root}/scripts/reference-source-check" --print-args > "$patch_file"
patch=()
while IFS= read -r argument; do
    [[ -n "$argument" ]] || continue
    patch+=("$argument")
done < "$patch_file"
if (( ${#patch[@]} == 0 )); then
    echo "error: empty public dependency patch table" >&2
    exit 1
fi

git -C "$repo_root" rev-parse HEAD
rustc --version --verbose
cargo --version
cd "${repo_root}/reference"
# Exercise native directory synchronization on the same host as publication.
"${repo_root}/scripts/cargo-test-exact" 6 durable_directory:: \
    "${list_only[@]+"${list_only[@]}"}" "${patch[@]}" \
    -p rafter-reference-harness --lib -- --test-threads=1 --nocapture
"${repo_root}/scripts/cargo-test-exact" 1 - \
    "${list_only[@]+"${list_only[@]}"}" "${patch[@]}" \
    -p rafter-reference-ledger --lib -- --ignored --exact \
    store::process_test::cases::ledger_publication_survives_process_loss \
    --test-threads=1 --nocapture
