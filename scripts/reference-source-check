#!/usr/bin/env bash
# Run the reference-consumer workspace in fast source mode.
#
# Usage:
#   scripts/reference-source-check              # fmt, clippy, and tests
#   scripts/reference-source-check --print-args # show the dependency overrides
#   scripts/reference-source-check -- <args>    # extra args for `cargo test`
#
# The reference consumers depend on published Rafter versions. This command
# patches those versions to the crates in this checkout so local changes are
# exercised before they are published. Path overrides stay here rather than in
# the canonical consumer manifests, which must keep resolving like an external
# user's manifest.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
reference_root="${repo_root}/reference"
print_args=false
test_args=()

usage() {
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --print-args)
            print_args=true
            ;;
        --)
            shift
            test_args=("$@")
            break
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

# Every publishable Rafter crate, whether or not a consumer reaches it yet.
# A crate missing from this list does not fail to resolve — it silently pulls
# the published registry copy, which is exactly the partially patched graph
# that links checkout code against published code of the same workspace. The
# process-composition slice hit that with the peer codec and demo transport,
# so the list is the publishable set, not the currently reached set.
patched_crates=(
    rafter
    rafter-app
    rafter-codec
    rafter-crc32
    rafter-multiraft
    rafter-runtime
    rafter-runtime-api
    rafter-service
    rafter-storage
    rafter-transport-tcp-insecure
)

# The list above is a closure claim -- "every publishable Rafter crate" -- and a
# hand-maintained list cannot keep one. Derive the same set from the manifests
# and refuse to run when they disagree, so adding a publishable crate fails here
# instead of silently resolving that crate from the registry in every consumer
# lane. A crate is publishable unless its manifest opts out with `publish =
# false`; that is the same predicate `cargo publish` applies.
publishable_crates=()
for manifest in "${repo_root}"/crates/*/Cargo.toml; do
    if grep -Eq '^publish[[:space:]]*=[[:space:]]*false' "$manifest"; then
        continue
    fi
    crate_dir="$(dirname "$manifest")"
    publishable_crates+=("$(basename "$crate_dir")")
done

declared="$(printf '%s\n' "${patched_crates[@]}" | LC_ALL=C sort)"
discovered="$(printf '%s\n' "${publishable_crates[@]}" | LC_ALL=C sort)"
if [[ "$declared" != "$discovered" ]]; then
    echo "error: patched_crates is not the publishable set" >&2
    echo "       fix the list in $0, or mark the new crate publish = false" >&2
    diff -u <(printf '%s\n' "$declared") <(printf '%s\n' "$discovered") >&2 || true
    exit 1
fi

config_args=()
for crate in "${patched_crates[@]}"; do
    crate_dir="${repo_root}/crates/${crate}"
    if [[ ! -f "${crate_dir}/Cargo.toml" ]]; then
        echo "error: patched crate is missing: ${crate_dir}" >&2
        exit 1
    fi
    config_args+=(--config "patch.crates-io.${crate}.path='${crate_dir}'")
done

if [[ "$print_args" == true ]]; then
    printf '%s\n' "${config_args[@]}"
    exit 0
fi

cd "$reference_root"

# `reference/Cargo.lock` is intentionally untracked: the source-mode lockfile
# records patched checkout paths, while package-consumer mode resolves the same
# manifests against unpacked archives and generates its own lockfile. Committing
# either one would pin a resolution the other mode has to rewrite.
echo "reference source mode: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "reference source mode: cargo clippy --all-targets -- -D warnings"
cargo clippy "${config_args[@]}" --all-targets -- -D warnings

echo "reference source mode: cargo test"
cargo test "${config_args[@]}" ${test_args[@]+"${test_args[@]}"}

# The consumers are read as exemplars, so a doc that cannot build is a defect in
# the artifact they exist to be. This gate was absent long enough for four
# public doc comments to link to private items, all written by the round that
# was correcting those same paragraphs.
echo "reference source mode: cargo doc --no-deps (RUSTDOCFLAGS=-D warnings)"
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps "${config_args[@]}"

echo "reference source mode passed"
