#!/usr/bin/env bash
# Orchestrates strict model-check cost comparisons. A baseline crossing a
# reviewed contract migration is split around its pinned pivot; all other runs
# remain a single like-for-like comparison.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE_REF="${MODEL_CHECK_BASE_REF:-origin/main}"
CURRENT_REF="${MODEL_CHECK_CURRENT_REF:-HEAD}"
PROFILE_LIST="${MODEL_CHECK_PROFILES:-fast}"
RUNS="${MODEL_CHECK_RUNS:-6}"
MAX_WALL_RATIO="${MODEL_CHECK_MAX_MEDIAN_WALL_RATIO:-2.25}"
MAX_RSS_RATIO="${MODEL_CHECK_MAX_MEDIAN_RSS_RATIO:-1.75}"
OUT_DIR="${OUT_DIR:-$ROOT/target/model-check-profile}"
MIGRATION_MANIFEST="${MODEL_CHECK_CONTRACT_MIGRATIONS:-verification/model-check-contract-migrations.json}"
PAIR="$ROOT/scripts/model-check-profile-pair"
MIGRATION_TOOL="$ROOT/scripts/model_check_contract_migration.py"

case "$OUT_DIR" in
  /*) ;;
  *) OUT_DIR="$ROOT/$OUT_DIR" ;;
esac
case "$MIGRATION_MANIFEST" in
  /*) ;;
  *) MIGRATION_MANIFEST="$ROOT/$MIGRATION_MANIFEST" ;;
esac

if [[ -d "$OUT_DIR" && -n "$(find "$OUT_DIR" -mindepth 1 -print -quit)" ]]; then
  echo "OUT_DIR must be empty so stale files cannot enter the evidence bundle: $OUT_DIR" >&2
  exit 2
fi
mkdir -p "$OUT_DIR/segments"
PLAN="$OUT_DIR/plan.json"

# Invoked by the EXIT finalizer.
# shellcheck disable=SC2329
write_manifest() {
  local temporary
  temporary="$(mktemp)"
  (
    cd "$OUT_DIR"
    find . -type f ! -name SHA256SUMS -print0 \
      | sort -z \
      | while IFS= read -r -d '' artifact; do
          LC_ALL=C LANG=C shasum -a 256 "$artifact"
        done > "$temporary"
  )
  mv "$temporary" "$OUT_DIR/SHA256SUMS"
}

# Invoked by the EXIT trap.
# shellcheck disable=SC2329
finalize() {
  local command_status="$?"
  local aggregate_status=0
  local manifest_status=0
  local final_status
  trap - EXIT
  python3 "$MIGRATION_TOOL" aggregate \
    --plan "$PLAN" \
    --repo "$ROOT" \
    --artifact-dir "$OUT_DIR" \
    --max-wall-ratio "$MAX_WALL_RATIO" \
    --max-rss-ratio "$MAX_RSS_RATIO" \
    --output-json "$OUT_DIR/compare.json" \
    --output-markdown "$OUT_DIR/compare.md" || aggregate_status="$?"
  write_manifest || manifest_status="$?"
  final_status="$command_status"
  if (( final_status == 0 && aggregate_status != 0 )); then
    final_status="$aggregate_status"
  fi
  if (( final_status == 0 && manifest_status != 0 )); then
    final_status="$manifest_status"
  fi
  exit "$final_status"
}
trap finalize EXIT

python3 "$MIGRATION_TOOL" plan \
  --repo "$ROOT" \
  --manifest "$MIGRATION_MANIFEST" \
  --base-ref "$BASE_REF" \
  --current-ref "$CURRENT_REF" \
  --profiles "$PROFILE_LIST" \
  --output "$PLAN"

plan_get() {
  python3 -c '
import json, sys
value = json.load(open(sys.argv[1]))
for part in sys.argv[2].split("."):
    value = value[int(part)] if isinstance(value, list) else value[part]
if isinstance(value, list):
    print(" ".join(value))
elif isinstance(value, bool):
    print(str(value).lower())
else:
    print(value)
' "$PLAN" "$1"
}

run_pair() {
  local name="$1"
  local base="$2"
  local current="$3"
  local profiles="$4"
  local runs="$5"
  local mode="$6"
  MODEL_CHECK_BASE_REF="$base" \
  MODEL_CHECK_CURRENT_REF="$current" \
  MODEL_CHECK_REQUESTED_BASE_REF="$base" \
  MODEL_CHECK_PROFILES="$profiles" \
  MODEL_CHECK_RUNS="$runs" \
  MODEL_CHECK_MAX_MEDIAN_WALL_RATIO="$MAX_WALL_RATIO" \
  MODEL_CHECK_MAX_MEDIAN_RSS_RATIO="$MAX_RSS_RATIO" \
  MODEL_CHECK_COMPARISON_MODE="$mode" \
  OUT_DIR="$OUT_DIR/segments/$name" \
    "$PAIR"
}

record_segment_failure() {
  printf '%s\n' "$1: evidence command exited nonzero" \
    >> "$OUT_DIR/orchestration-errors.log"
  RUN_STATUS=1
}

MODE="$(plan_get comparison_mode)"
RUN_STATUS=0
if [[ "$MODE" == like-for-like ]]; then
  run_pair \
    like-for-like \
    "$(plan_get segments.0.base_commit)" \
    "$(plan_get segments.0.current_commit)" \
    "$(plan_get segments.0.profiles)" \
    "$RUNS" \
    like-for-like || record_segment_failure like-for-like
elif [[ "$MODE" == monotone-bound-migration ]]; then
  if [[ "$(plan_get segments.0.required)" == true ]]; then
    run_pair \
      pre-migration \
      "$(plan_get segments.0.base_commit)" \
      "$(plan_get segments.0.current_commit)" \
      "$(plan_get segments.0.profiles)" \
      "$RUNS" \
      like-for-like || record_segment_failure pre-migration
  fi
  if [[ "$(plan_get segments.1.required)" == true ]]; then
    run_pair \
      post-migration \
      "$(plan_get segments.1.base_commit)" \
      "$(plan_get segments.1.current_commit)" \
      "$(plan_get segments.1.profiles)" \
      "$RUNS" \
      like-for-like || record_segment_failure post-migration
  fi
  run_pair \
    migration-delta \
    "$(plan_get segments.2.base_commit)" \
    "$(plan_get segments.2.current_commit)" \
    "$(plan_get segments.2.profiles)" \
    2 \
    migration-delta || record_segment_failure migration-delta
else
  echo "unsupported planned comparison mode: $MODE" >&2
  RUN_STATUS=1
fi

exit "$RUN_STATUS"
