#!/usr/bin/env bash
# Compares rafter-model-check-fast profile cost between this checkout and a
# baseline ref, recording wall time, peak RSS, state counts, actions, and
# pruning. Build time is excluded from the measured command.
#
# Usage:
#   scripts/model-check-profile-compare
#   MODEL_CHECK_PROFILES="fast" scripts/model-check-profile-compare
#   MODEL_CHECK_BASE_REF=main OUT_DIR=target/model-check-profile scripts/model-check-profile-compare
#
# Environment:
#   CARGO                  Cargo executable. Defaults to cargo.
#   MODEL_CHECK_BASE_REF   Baseline git ref. Defaults to origin/main.
#   MODEL_CHECK_PROFILES   Space-separated profiles. Defaults to "fast raft-deep".
#   OUT_DIR                Artifact directory. Defaults to target/model-check-profile.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CARGO="${CARGO:-cargo}"
BASE_REF="${MODEL_CHECK_BASE_REF:-origin/main}"
PROFILE_LIST="${MODEL_CHECK_PROFILES:-fast raft-deep}"
OUT_DIR="${OUT_DIR:-$ROOT/target/model-check-profile}"
OUT_JSON="$OUT_DIR/compare.json"
OUT_MD="$OUT_DIR/compare.md"
TIME_BIN="${TIME_BIN:-/usr/bin/time}"

case "$OUT_DIR" in
  /*) ;;
  *) OUT_DIR="$ROOT/$OUT_DIR" ;;
esac
OUT_JSON="$OUT_DIR/compare.json"
OUT_MD="$OUT_DIR/compare.md"

read -r -a PROFILES <<< "$PROFILE_LIST"
if [[ "${#PROFILES[@]}" -eq 0 ]]; then
  echo "MODEL_CHECK_PROFILES must name at least one profile" >&2
  exit 2
fi

mkdir -p "$OUT_DIR"

detect_time_style() {
  local probe
  probe="$(mktemp)"
  if "$TIME_BIN" -l true >/dev/null 2>"$probe"; then
    rm -f "$probe"
    echo "bsd"
    return
  fi
  if "$TIME_BIN" -v true >/dev/null 2>"$probe"; then
    rm -f "$probe"
    echo "gnu"
    return
  fi
  if "$TIME_BIN" -p true >/dev/null 2>"$probe"; then
    rm -f "$probe"
    echo "posix"
    return
  fi
  rm -f "$probe"
  echo "unsupported"
}

TIME_STYLE="$(detect_time_style)"
if [[ "$TIME_STYLE" == "unsupported" ]]; then
  echo "cannot run timing wrapper: $TIME_BIN supports neither -l, -v, nor -p" >&2
  exit 2
fi
if [[ "$TIME_STYLE" == "posix" ]]; then
  echo "warning: $TIME_BIN cannot report peak RSS here; JSON will use null peak_rss_bytes" >&2
fi

TMP_DIR="$(mktemp -d)"
cleanup() {
  if [[ -d "$TMP_DIR/base" ]]; then
    git -C "$ROOT" worktree remove --force "$TMP_DIR/base" >/dev/null 2>&1 || true
  fi
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

BASE_COMMIT="$(git -C "$ROOT" rev-parse "$BASE_REF")"
CURRENT_COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
git -C "$ROOT" worktree add --detach "$TMP_DIR/base" "$BASE_COMMIT" >/dev/null

build_binary() {
  local label="$1"
  local checkout="$2"
  local target_dir="$OUT_DIR/$label-target"
  echo "==> building $label rafter-model-check-fast" >&2
  (cd "$checkout" && CARGO_TARGET_DIR="$target_dir" "$CARGO" build --release -p rafter-sim --bin rafter-model-check-fast)
  printf '%s\n' "$target_dir/release/rafter-model-check-fast"
}

run_profile() {
  local label="$1"
  local binary="$2"
  local profile="$3"
  local stdout="$OUT_DIR/$label-$profile.stdout"
  local stderr="$OUT_DIR/$label-$profile.time"

  echo "==> running $label profile=$profile"
  if [[ "$TIME_STYLE" == "bsd" ]]; then
    if ! "$TIME_BIN" -l "$binary" --profile "$profile" >"$stdout" 2>"$stderr"; then
      cat "$stdout" >&2 || true
      cat "$stderr" >&2 || true
      exit 1
    fi
  elif [[ "$TIME_STYLE" == "gnu" ]]; then
    if ! "$TIME_BIN" -v "$binary" --profile "$profile" >"$stdout" 2>"$stderr"; then
      cat "$stdout" >&2 || true
      cat "$stderr" >&2 || true
      exit 1
    fi
  else
    if ! "$TIME_BIN" -p "$binary" --profile "$profile" >"$stdout" 2>"$stderr"; then
      cat "$stdout" >&2 || true
      cat "$stderr" >&2 || true
      exit 1
    fi
  fi
}

BASE_BIN="$(build_binary base "$TMP_DIR/base")"
CURRENT_BIN="$(build_binary current "$ROOT")"

for profile in "${PROFILES[@]}"; do
  run_profile base "$BASE_BIN" "$profile"
  run_profile current "$CURRENT_BIN" "$profile"
done

OUT_DIR="$OUT_DIR" OUT_JSON="$OUT_JSON" OUT_MD="$OUT_MD" \
BASE_REF="$BASE_REF" BASE_COMMIT="$BASE_COMMIT" CURRENT_COMMIT="$CURRENT_COMMIT" \
TIME_STYLE="$TIME_STYLE" PROFILES="$PROFILE_LIST" python3 - <<'PY'
import datetime as dt
import json
import os
import re
from pathlib import Path

out_dir = Path(os.environ["OUT_DIR"])
profiles = os.environ["PROFILES"].split()
time_style = os.environ["TIME_STYLE"]


def parse_kv_fields(text):
    fields = {}
    for item in text.split():
        if "=" not in item:
            continue
        key, value = item.split("=", 1)
        value = value.strip()
        if re.fullmatch(r"-?\d+", value):
            fields[key] = int(value)
        elif re.fullmatch(r"-?\d+\.\d+", value):
            fields[key] = float(value)
        else:
            fields[key] = value
    return fields


def parse_model_output(path):
    checks = []
    for line in path.read_text().splitlines():
        match = re.match(r"^model-check ([^:]+): (.*)$", line)
        if not match:
            continue
        fields = parse_kv_fields(match.group(2))
        if "unique_states" not in fields:
            continue
        compat = "unique_protocol_states" not in fields
        if compat:
            fields["unique_protocol_states"] = fields["unique_states"]
            fields["unique_verifier_states"] = fields["unique_states"]
            fields["pruned_states"] = max(
                0, fields.get("explored_states", 0) - fields["unique_states"]
            )
            explored = fields.get("explored_states", 0)
            fields["pruning_rate"] = (
                fields["pruned_states"] / explored if explored else 0.0
            )
        checks.append({"name": match.group(1), "compat_counts": compat, **fields})
    return checks


def parse_elapsed_to_ms(value):
    parts = value.strip().split(":")
    if len(parts) == 1:
        return round(float(parts[0]) * 1000)
    if len(parts) == 2:
        minutes, seconds = parts
        return round((int(minutes) * 60 + float(seconds)) * 1000)
    hours, minutes, seconds = parts
    return round((int(hours) * 3600 + int(minutes) * 60 + float(seconds)) * 1000)


def parse_time(path):
    text = path.read_text()
    if time_style == "bsd":
        real_ms = None
        peak_rss_bytes = None
        for line in text.splitlines():
            real = re.search(r"([0-9.]+)\s+real", line)
            if real:
                real_ms = round(float(real.group(1)) * 1000)
            rss = re.match(r"^\s*(\d+)\s+maximum resident set size$", line)
            if rss:
                peak_rss_bytes = int(rss.group(1))
        return {"wall_time_ms": real_ms, "peak_rss_bytes": peak_rss_bytes}

    if time_style == "gnu":
        elapsed = re.search(r"Elapsed \(wall clock\) time .*: ([0-9:.]+)", text)
        rss = re.search(r"Maximum resident set size \(kbytes\): (\d+)", text)
        return {
            "wall_time_ms": parse_elapsed_to_ms(elapsed.group(1)) if elapsed else None,
            "peak_rss_bytes": int(rss.group(1)) * 1024 if rss else None,
        }

    real = re.search(r"^real\s+([0-9.]+)$", text, re.MULTILINE)
    return {
        "wall_time_ms": round(float(real.group(1)) * 1000) if real else None,
        "peak_rss_bytes": None,
    }


def aggregate(checks):
    totals = {
        "check_count": len(checks),
        "explored_actions": 0,
        "explored_states": 0,
        "unique_protocol_states": 0,
        "unique_verifier_states": 0,
        "pruned_states": 0,
        "compat_counts": any(check.get("compat_counts", False) for check in checks),
    }
    for check in checks:
        for key in [
            "explored_actions",
            "explored_states",
            "unique_protocol_states",
            "unique_verifier_states",
            "pruned_states",
        ]:
            totals[key] += int(check.get(key, 0))
    explored = totals["explored_states"]
    totals["pruning_rate"] = totals["pruned_states"] / explored if explored else 0.0
    return totals


runs = []
for label, commit in [
    ("base", os.environ["BASE_COMMIT"]),
    ("current", os.environ["CURRENT_COMMIT"]),
]:
    for profile in profiles:
        stdout = out_dir / f"{label}-{profile}.stdout"
        timing = out_dir / f"{label}-{profile}.time"
        checks = parse_model_output(stdout)
        run = {
            "label": label,
            "profile": profile,
            "commit": commit,
            "stdout": str(stdout),
            "time_log": str(timing),
            **parse_time(timing),
            "totals": aggregate(checks),
            "checks": checks,
        }
        runs.append(run)

report = {
    "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
    "base_ref": os.environ["BASE_REF"],
    "base_commit": os.environ["BASE_COMMIT"],
    "current_commit": os.environ["CURRENT_COMMIT"],
    "profiles": profiles,
    "time_style": time_style,
    "runs": runs,
}
Path(os.environ["OUT_JSON"]).write_text(json.dumps(report, indent=2) + "\n")


def mib(value):
    if value is None:
        return "n/a"
    return f"{value / (1024 * 1024):.1f}"


lines = [
    "# Model-Check Profile Comparison",
    "",
    f"- Base ref: `{os.environ['BASE_REF']}` (`{os.environ['BASE_COMMIT']}`)",
    f"- Current: `{os.environ['CURRENT_COMMIT']}`",
    f"- Generated: `{report['generated_at']}`",
    "",
    "| Label | Profile | Wall s | Peak RSS MiB | Checks | Explored actions | Protocol states | Verifier states | Pruning rate | Compat counts |",
    "| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | --- |",
]
for run in runs:
    totals = run["totals"]
    wall = "n/a" if run["wall_time_ms"] is None else f"{run['wall_time_ms'] / 1000:.3f}"
    lines.append(
        "| {label} | {profile} | {wall} | {rss} | {checks} | {actions} | {protocol} | {verifier} | {pruning:.6f} | {compat} |".format(
            label=run["label"],
            profile=run["profile"],
            wall=wall,
            rss=mib(run["peak_rss_bytes"]),
            checks=totals["check_count"],
            actions=totals["explored_actions"],
            protocol=totals["unique_protocol_states"],
            verifier=totals["unique_verifier_states"],
            pruning=totals["pruning_rate"],
            compat="yes" if totals["compat_counts"] else "no",
        )
    )
lines.append("")
lines.append("`compat_counts=yes` means that checkout emitted the legacy `unique_states` field only; the script records it as both protocol and verifier count for baseline comparison.")
Path(os.environ["OUT_MD"]).write_text("\n".join(lines) + "\n")

print(f"wrote {os.environ['OUT_JSON']}")
print(f"wrote {os.environ['OUT_MD']}")
PY
