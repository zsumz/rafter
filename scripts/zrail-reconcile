#!/usr/bin/env python3
"""Prune stale generated allowances; never infer or grant macro authority.

Usage: scripts/zrail-reconcile [--dry-run]
Exit 0 means the block is stable, not that zrail check passed. Exit 2 means
stale entries were removed (or would be). Exit 1 requires explicit review and
leaves the contract untouched, including when stale entries also exist.

Findings do not prove macro origin. A familiar final name, builtin spelling,
new item site, or opaque-input change therefore cannot authorize an allowance.
Add reviewed identities manually, then run the authoritative zrail check.
"""

import json
import re
import subprocess
import sys
import tomllib
from pathlib import Path

CONTRACT = Path(__file__).resolve().parent.parent / "zrail.toml"
BEGIN = "# >>> generated: observed spellings\n"
END = "# <<< generated: observed spellings\n"


def reconcile(text, findings):
    """Return a pruned contract or raise before any mutation needs to occur."""
    begin = text.index(BEGIN) + len(BEGIN)
    end = text.index(END)
    stale_macros, stale_items, decisions = set(), set(), []
    for finding in findings:
        rule = finding["id"]
        message = finding.get("message") or ""
        if rule == "RUST-MACRO-002":
            match = re.search(r'allowed macro expansion "([^"]+)"', message)
            if not match:
                raise ValueError(f"unrecognized stale allowance: {message}")
            stale_macros.add(match[1])
        elif rule == "RUST-GRAPH-005":
            match = re.search(r"item macro exemption (\S+)! ", message)
            if not match or not finding.get("path"):
                raise ValueError(f"unrecognized stale item site: {message}")
            stale_items.add((finding["path"], match[1]))
        elif rule.startswith("RUST-MACRO") or rule == "RUST-GRAPH-003":
            decisions.append(f"{rule}: {finding.get('path', '')}: {message}")
    if decisions:
        raise ValueError("explicit macro identity/site review required:\n" + "\n".join(decisions))

    # Preserve every surviving reviewed block verbatim, including its reason.
    blocks = re.split(r"(?=\[\[source\.rust\.)", text[begin:end])
    retained = []
    for block in blocks:
        parsed = tomllib.loads(block).get("source", {}).get("rust", {})
        allows = parsed.get("macros", {}).get("allow", [])
        items = parsed.get("item_macros", [])
        if any(entry["name"] in stale_macros for entry in allows):
            continue
        if any((entry["path"], entry["name"]) in stale_items for entry in items):
            continue
        retained.append(block)
    return text[:begin] + "".join(retained) + text[end:]


def main():
    if sys.argv[1:] not in ([], ["--dry-run"]):
        raise ValueError("usage: scripts/zrail-reconcile [--dry-run]")
    result = subprocess.run(
        ["zrail", "check", "--format", "json"], capture_output=True, text=True, check=False
    )
    if result.returncode not in (0, 1):
        raise ValueError(f"zrail check failed: {result.stderr}")
    findings = json.loads(result.stdout)["findings"]
    text = CONTRACT.read_text()
    proposed = reconcile(text, findings)
    if proposed == text:
        print("generated block stable; run zrail check for the authoritative verdict")
        return 0
    if "--dry-run" in sys.argv:
        print("stale generated entries would be removed (dry run)")
    else:
        CONTRACT.write_text(proposed)
        print("removed stale generated entries; no authority added")
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, KeyError, OSError) as error:
        print(error, file=sys.stderr)
        raise SystemExit(1) from error
