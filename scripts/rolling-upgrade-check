#!/usr/bin/env python3
"""Qualify published/candidate Raft libraries in real authenticated processes."""

import json
import os
from pathlib import Path
import re
import shutil
import sys
import tomllib

from archive_compatibility import ArchiveRun, ROOT, run_matrix
from archive_inputs import audit_graph, sha256, tree_inventory

TEST = "published_nodes_roll_to_candidate_with_tls_snapshots_and_membership"
STAGES = ("all-published", "candidate-received-published-snapshot", "leader-upgraded",
          "published-received-candidate-snapshot", "all-candidate", "candidate-restarts-complete")
# These consumers resolve all eleven archives and own the unchanged process
# fixture. Ledger-only candidate APIs are qualified by the exact-package lane;
# resolving them against historical releases would demand nonexistent features.
MEMBERS = ("fenced-lock", "harness", "sharded-counter")
CRASHES = (("published-to-candidate", 3), ("published-to-candidate", 1),
           ("published-to-candidate", 2), ("candidate-restart", 1),
           ("candidate-restart", 2), ("candidate-restart", 3))
PACKAGES = frozenset(("rafter", "rafter-app", "rafter-codec", "rafter-crc32", "rafter-runtime",
                      "rafter-runtime-api", "rafter-service", "rafter-storage", "rafter-multiraft",
                      "rafter-transport-tcp-insecure", "rafter-transport-tls"))


def copy_consumer(fixture, consumer):
    """Use the same public process consumer bytes against both archive sets."""
    manifest = (fixture / "Cargo.toml").read_text()
    members = tomllib.loads(manifest)["workspace"]["members"]
    if not set(MEMBERS).issubset(members):
        raise ValueError("rolling consumer workspace is missing a required member")
    manifest, count = re.subn(r"(?m)^members = \[[^\n]*\]$",
                              "members = " + json.dumps(MEMBERS), manifest)
    if count != 1 or tomllib.loads(manifest)["workspace"]["members"] != list(MEMBERS):
        raise ValueError("rolling consumer workspace member declaration changed shape")
    consumer.mkdir(parents=True)
    (consumer / "Cargo.toml").write_text(manifest)
    for name in MEMBERS:
        shutil.copytree(fixture / name, consumer / name,
                        ignore=shutil.ignore_patterns("target", "Cargo.lock", ".cargo"))


def crash_records(transcript, mode):
    if mode not in ("graceful", "sigkill") or re.findall(
            r"UPGRADE_REPLACEMENTS mode=(\S+)", transcript) != [mode]:
        raise ValueError("rolling-upgrade replacement mode is missing or ambiguous")
    records = [{"stage": stage, "node": int(node), "pid": int(pid), "signal": int(signal)}
               for stage, node, pid, signal in re.findall(
                   r"UPGRADE_CRASH stage=(\S+) node=(\d+) pid=(\d+) signal=(\d+)", transcript)]
    expected = list(CRASHES) if mode == "sigkill" else []
    if ([(r["stage"], r["node"]) for r in records] != expected
            or transcript.count("UPGRADE_CRASH ") != len(records)
            or any(r["pid"] == 0 or r["signal"] != 9 for r in records)):
        raise ValueError("rolling-upgrade requires the exact ordered SIGKILL replacements")
    return records


def crash_inventory(directory):
    inventory = tree_inventory(directory)
    expected = {f"{stage}-node-{node}" for stage, node in CRASHES}
    if {Path(name).parts[0] for name in inventory} != expected:
        raise ValueError("rolling-upgrade pre-recovery cases are incomplete or unexpected")
    for case in expected:
        for name in ("replica-identity", "control-plane", "transport-replay",
                     "raft/hard-state"):
            item = inventory.get(f"{case}/{name}", {})
            if item.get("kind") != "file" or item.get("bytes", 0) == 0:
                raise ValueError(f"rolling-upgrade pre-recovery input missing: {case}/{name}")
        # Prefix compaction can leave a valid empty retained log.
        if inventory.get(f"{case}/raft/log", {}).get("kind") != "file":
            raise ValueError(f"rolling-upgrade pre-recovery input missing: {case}/raft/log")
        if not any(inventory.get(f"{case}/app/lock-state.{slot}", {}).get("bytes", 0)
                   for slot in (0, 1)):
            raise ValueError(f"rolling-upgrade pre-recovery application state missing: {case}")
    return inventory


def observations(transcript, mode="graceful"):
    """Refuse empty, incomplete, duplicated, or unready process evidence."""
    crash_records(transcript, mode)
    result = []
    seen = set()
    for match in re.finditer(r"UPGRADE_OBSERVATION stage=(\S+) node=(\d+) (\{[^\n]+\})", transcript):
        stage, node, raw = match.groups()
        key = (stage, int(node))
        data = json.loads(raw)
        if key in seen or key[0] not in STAGES or key[1] not in (1, 2, 3):
            raise ValueError("duplicate or unexpected rolling-upgrade observation")
        if data.get("node") != key[1] or data.get("ready") is not True:
            raise ValueError("rolling-upgrade observation is unready or has wrong identity")
        seen.add(key)
        result.append({"stage": stage, "node": key[1], "observation": data})
    if seen != {(stage, node) for stage in STAGES for node in (1, 2, 3)}:
        raise ValueError("rolling-upgrade transcript is missing a required stage or node")
    history = re.findall(r"UPGRADE_HISTORY searched=(\d+) discharged=(\d+) events=", transcript)
    retries = list(map(int, re.findall(r"UPGRADE_RETRY attempt=(\d+) ", transcript)))
    if not 1 <= len(retries) <= 8 or retries != list(range(1, len(retries) + 1)):
        raise ValueError("rolling-upgrade transcript lacks bounded, ordered unknown-outcome retries")
    if len(history) != 1 or int(history[0][0]) != 24 + len(retries):
        raise ValueError("rolling-upgrade checked history must retain every unknown attempt")
    if transcript.count("UPGRADE_LOST_REPLY node=") != 1:
        raise ValueError("rolling-upgrade transcript lacks the deliberate lost reply")
    for marker in ("UPGRADE_MEMBERSHIP mixed-versions learner-promoted-and-retired",
                   "UPGRADE_COMPLETE published-to-candidate tls snapshots-both-directions membership durable-restarts",
                   "test result: ok. 1 passed; 0 failed;"):
        if transcript.count(marker) != 1:
            raise ValueError(f"rolling-upgrade transcript lacks unique completion: {marker}")
    return result


class Run(ArchiveRun):
    label = "rolling-upgrade"
    scope = "published/candidate libraries; same current public consumer; real TLS, snapshots, membership, orderly and SIGKILL replacement"
    packages = PACKAGES
    fixture = ROOT / "reference"
    baseline = ROOT / "verification/rolling-upgrade-baseline.json"
    script = "rolling-upgrade-check"

    def runner_files(self):
        return [*super().runner_files(), "reference-package-boundary-check"]

    def fixture_files(self):
        for directory, children, files in os.walk(self.fixture):
            children[:] = sorted(name for name in children if name not in ("target", ".cargo")
                                 and (Path(directory) != self.fixture or name in MEMBERS))
            for name in sorted(files):
                path = Path(directory) / name
                if path.suffix in (".rs", ".toml", ".pem"):
                    yield path

    def build(self, role, archives, work):
        directory, roots, version, archive_records = self.archive_set(role, archives, work)
        consumer = directory / "consumer" / "reference"
        copy_consumer(self.fixture, consumer)
        # This identical public consumer is compiled against each version set.
        # Only dependency versions change; no source or behavior is substituted.
        for manifest in consumer.rglob("Cargo.toml"):
            contents = manifest.read_text()
            for name in sorted(self.packages):
                contents = re.sub(r'(?m)^(' + re.escape(name) + r'\s*=\s*")=[^"]+("\s*)$',
                                  lambda match: match[1] + "=" + version + match[2], contents)
            manifest.write_text(contents)
        (consumer / ".cargo").mkdir()
        (consumer / ".cargo/config.toml").write_text("[patch.crates-io]\n" + "".join(
            f"{name} = {{ path = {json.dumps(str(path))} }}\n" for name, path in sorted(roots.items())))
        target = directory / "target"
        self.cargo(f"{role}-lock", ["generate-lockfile"], consumer, target)
        metadata_path = self.cargo(f"{role}-metadata", ["metadata", "--locked", "--format-version=1"],
                                   consumer, target)
        metadata = json.loads(metadata_path.read_text())
        workspace = {"rafter-reference-" + name: consumer / name / "Cargo.toml" for name in MEMBERS}
        audit_graph(metadata, ROOT, roots, consumer, "", workspace=workspace)
        never_publish = directory / "never-publish.txt"
        # The strict graph audit already limits every local package to these
        # three public consumers and the exact archive set. Keep the existing
        # manifest scanner too: it catches dormant forbidden declarations.
        never_publish.write_text("rafter-sim\nrafter-maelstrom\nrafter-invariants\nrafter-invariant-test\nrafter-invariant-test-macros\nrafter-fuzz\n")
        self.command(f"{role}-boundary", [ROOT / "scripts/reference-package-boundary-check",
            "--metadata", metadata_path, "--checkout-root", ROOT, "--unpack-root", directory,
            "--consumer-workspace", consumer, "--harness-path", consumer / "harness",
            "--never-publish-file", never_publish], consumer)
        self.cargo(f"{role}-build", ["build", "--locked", "-p", "rafter-reference-fenced-lock",
                                   "--bin", "lock-production-node"], consumer, target)
        binary = target / "debug" / "lock-production-node"
        if role == "candidate":
            output = self.cargo("candidate-test-build", ["test", "--no-run", "--locked", "-p",
                "rafter-reference-fenced-lock", "--test", "process_rolling_upgrade",
                "--message-format=json"], consumer, target)
            tests = [Path(item["executable"]) for line in output.read_text().splitlines()
                     if (item := json.loads(line)).get("reason") == "compiler-artifact"
                     and item["target"]["name"] == "process_rolling_upgrade"
                     and item.get("executable") and item["profile"]["test"]]
            if len(tests) != 1 or not tests[0].resolve().is_relative_to(target):
                raise ValueError("expected one isolated candidate rolling-upgrade test binary")
            self.test_binary = tests[0]
            self.receipt["test_binary_sha256"] = sha256(self.test_binary)
        lock = self.artifacts / f"{role}-Cargo.lock"
        shutil.copyfile(consumer / "Cargo.lock", lock)
        self.receipt[role] = {"consumer_members": list(MEMBERS), "archives": archive_records, "binary_sha256": sha256(binary),
                             "lock_sha256": sha256(lock), "metadata_sha256": sha256(metadata_path)}
        return binary

    def matrix(self, baseline, candidate):
        listing = self.command("test-inventory", [self.test_binary, "--list", "--format=terse"], ROOT)
        if listing.read_text().strip() != f"{TEST}: test":
            raise ValueError("rolling-upgrade test inventory is not the expected singleton")
        cases = []
        for mode in ("graceful", "sigkill"):
            env = os.environ.copy()
            env.pop("RAFTER_UPGRADE_CRASH_STATE", None)
            state = "durable-state" if mode == "graceful" else "crash-durable-state"
            command = "rolling-processes" if mode == "graceful" else "rolling-crash-processes"
            env.update(RAFTER_BASELINE_NODE=str(baseline), RAFTER_CANDIDATE_NODE=str(candidate),
                       RAFTER_UPGRADE_STATE=str(self.artifacts / state))
            if mode == "sigkill":
                env["RAFTER_UPGRADE_CRASH_STATE"] = str(self.artifacts / "crash-inputs")
            output = self.command(command, [self.test_binary, "--exact", TEST, "--ignored",
                                  "--nocapture", "--test-threads=1"], ROOT, env)
            transcript = output.read_text()
            cases.extend({"replacement_mode": mode, **case} for case in observations(transcript, mode))
            inventory = tree_inventory(self.artifacts / state)
            if not inventory:
                raise ValueError("rolling-upgrade durable state was not retained")
            key = "durable_state" if mode == "graceful" else "crash_durable_state"
            self.receipt[key] = inventory
            if mode == "sigkill":
                self.receipt["replacement_crashes"] = crash_records(transcript, mode)
                self.receipt["pre_recovery_state"] = crash_inventory(self.artifacts / "crash-inputs")
        self.receipt["cases"] = cases


if __name__ == "__main__":
    sys.exit(run_matrix(Run, __doc__))
