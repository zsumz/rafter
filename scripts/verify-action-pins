#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock="$root/verification/github-actions.lock"
while IFS= read -r specification; do
  [[ -n "$specification" ]] || continue
  action="${specification%@*}"
  revision="${specification##*@}"
  IFS=/ read -r owner repository _ <<< "$action"
  printf 'verify %s/%s@%s\n' "$owner" "$repository" "$revision"
  url="https://api.github.com/repos/$owner/$repository/git/commits/$revision"
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    curl --fail --silent --show-error \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      -H "Authorization: Bearer $GITHUB_TOKEN" \
      "$url" >/dev/null
  else
    curl --fail --silent --show-error \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      "$url" >/dev/null
  fi
done < "$lock"
