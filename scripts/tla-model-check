#!/usr/bin/env bash
# Run TLC against the Raft TLA+ specification.
#
# Usage:
#   scripts/tla-model-check               # PR 2-voter bounds (RaftCi.cfg, hours)
#   scripts/tla-model-check --nightly     # nightly 3-voter bounds (RaftNightly.cfg)
#   scripts/tla-model-check --full        # weekly: --nightly bounds, no symmetry
#   scripts/tla-model-check --joint-quorum # 4-voter joint quorums, manual only
#   scripts/tla-model-check --joint-quorum-focused-next # same bounds, MembershipNext
#   scripts/tla-model-check --joint-quorum-focused-init # also from JointQuorumInit
#   scripts/tla-model-check --trace-sample # TLC-check generated Rust trace sample
#   scripts/tla-model-check --print-config [--nightly|--full|--joint-quorum]
#
# --full is not a larger model. Raft.cfg and RaftNightly.cfg carry identical
# constants; only SYMMETRY differs, so the weekly tier checks the symmetry
# quotient rather than exploring further. --joint-quorum is the only config
# here that reaches a joint configuration with an empty quorum core; it is not
# wired to any profile. See docs/model-checking.md.
#
# The two --joint-quorum-focused-* configs carry --joint-quorum's bounds and
# invariants but replace Next with a focused proof obligation, checking less of
# the protocol in exchange for a smaller state space. Neither is wired to a
# profile, and neither has been observed to exhaust at four voters; the measured
# trajectories are in docs/model-checking.md.
#
# Uses the jar installed by zactionsz/tla-tools through TLA2TOOLS_JAR, or the
# conventional tools/cache/tla2tools.jar path for a local run. The digest is
# independently checked against Rafter's source-bound contract before TLC runs.
set -euo pipefail

repo_root="${RAFTER_TLA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
config="RaftCi.cfg"
module="Raft.tla"
print_config=false
workers=4
seed=2026071101
max_heap="8g"
fp_mem="0.45"

usage() {
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ci)
            config="RaftCi.cfg"
            workers=4
            seed=2026071101
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --nightly)
            config="RaftNightly.cfg"
            workers=auto
            seed=2026071102
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --full)
            config="Raft.cfg"
            workers=auto
            seed=2026071103
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --joint-quorum)
            config="RaftJointQuorum.cfg"
            workers=4
            seed=2026071104
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --joint-quorum-focused-next)
            config="RaftJointQuorumFocusedNext.cfg"
            workers=4
            seed=2026071105
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --joint-quorum-focused-init)
            config="RaftJointQuorumFocusedInit.cfg"
            workers=4
            seed=2026071106
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --trace-sample)
            config="RaftTraceSample.cfg"
            module="RaftTraceSample.tla"
            workers=1
            max_heap=""
            fp_mem=""
            ;;
        --print-config)
            print_config=true
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

max_heap="${RAFTER_TLA_MAX_HEAP:-$max_heap}"
fp_mem="${RAFTER_TLA_FP_MEM:-$fp_mem}"

if [[ "$print_config" == true ]]; then
    echo "$config"
    exit 0
fi

jar="${TLA2TOOLS_JAR:-${repo_root}/tools/cache/tla2tools.jar}"
expected="$(awk '$1 !~ /^#/ && $2 == "tla2tools.jar" { print $1 }' "${repo_root}/tools/tla/SHA256SUMS")"

if [[ ! "$expected" =~ ^[0-9a-f]{64}$ ]]; then
    echo "error: tools/tla/SHA256SUMS must contain one tla2tools.jar SHA-256" >&2
    exit 1
fi
if [[ ! -f "$jar" ]]; then
    echo "error: pinned tla2tools.jar is missing; run zactionsz/tla-tools or set TLA2TOOLS_JAR" >&2
    exit 1
fi
actual="$(openssl dgst -sha256 "$jar" | awk '{ print $NF }')"
if [[ "$actual" != "$expected" ]]; then
    echo "error: tla2tools.jar sha256 mismatch against tools/tla/SHA256SUMS" >&2
    exit 1
fi

cd "${repo_root}/specs/tla/raft"
echo "running TLC with ${config}"
java_args=(-XX:+UseParallelGC)
if [[ -n "$max_heap" ]]; then
    java_args=("-Xmx${max_heap}" "${java_args[@]}")
fi
tlc_args=(-workers "$workers" -seed "$seed" -fp 0)
if [[ -n "$fp_mem" ]]; then
    tlc_args+=(-fpmem "$fp_mem")
fi
exec java "${java_args[@]}" -cp "$jar" tlc2.TLC \
    "${tlc_args[@]}" -config "$config" "$module"
