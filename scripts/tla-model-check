#!/usr/bin/env bash
# Run TLC against the Raft TLA+ specification.
#
# Usage:
#   scripts/tla-model-check               # temporary refactor bounds (seconds)
#   scripts/tla-model-check --ci          # temporary PR bounds (RaftRefactor.cfg)
#   scripts/tla-model-check --canonical   # full PR bounds (RaftCi.cfg)
#   scripts/tla-model-check --nightly     # nightly 3-voter bounds (RaftNightly.cfg)
#   scripts/tla-model-check --full        # full local bounds (Raft.cfg, hours+)
#   scripts/tla-model-check --trace-sample # TLC-check generated Rust trace sample
#   scripts/tla-model-check --fetch-tool  # fetch and verify the pinned TLC jar
#   scripts/tla-model-check --print-config [--canonical|--nightly|--full]
#
# Downloads the immutable GitHub release asset pinned by tools/tla/ASSET_ID
# into tools/cache/ and verifies it against tools/tla/SHA256SUMS before running.
set -euo pipefail

repo_root="${RAFTER_TLA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
config="RaftRefactor.cfg"
module="Raft.tla"
print_config=false
fetch_tool=false
workers=4
seed=2026071101
max_heap="8g"
fp_mem="0.45"

usage() {
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ci)
            config="RaftRefactor.cfg"
            workers=4
            seed=2026071101
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --canonical)
            config="RaftCi.cfg"
            workers=4
            seed=2026071101
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --nightly)
            config="RaftNightly.cfg"
            workers=auto
            seed=2026071102
            max_heap="8g"
            fp_mem="0.45"
            ;;
        --full)
            config="Raft.cfg"
            workers=auto
            seed=2026071103
            max_heap="4g"
            fp_mem="0.45"
            ;;
        --trace-sample)
            config="RaftTraceSample.cfg"
            module="RaftTraceSample.tla"
            workers=1
            max_heap=""
            fp_mem=""
            ;;
        --fetch-tool)
            fetch_tool=true
            ;;
        --print-config)
            print_config=true
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

max_heap="${RAFTER_TLA_MAX_HEAP:-$max_heap}"
fp_mem="${RAFTER_TLA_FP_MEM:-$fp_mem}"

if [[ "$print_config" == true ]]; then
    echo "$config"
    exit 0
fi

cache_dir="${repo_root}/tools/cache"
jar="${cache_dir}/tla2tools.jar"
version="$(cat "${repo_root}/tools/tla/VERSION")"
asset_id="$(cat "${repo_root}/tools/tla/ASSET_ID")"
expected="$(awk '$1 !~ /^#/ && $2 == "tla2tools.jar" { print $1 }' "${repo_root}/tools/tla/SHA256SUMS")"

if [[ ! "$asset_id" =~ ^[0-9]+$ ]]; then
    echo "error: tools/tla/ASSET_ID must contain one numeric GitHub asset ID" >&2
    exit 1
fi
if [[ ! "$expected" =~ ^[0-9a-f]{64}$ ]]; then
    echo "error: tools/tla/SHA256SUMS must contain one tla2tools.jar SHA-256" >&2
    exit 1
fi

verify() {
    local candidate="${1:-$jar}"
    local actual
    actual="$(openssl dgst -sha256 "$candidate" | awk '{ print $NF }')"
    [[ "$actual" == "$expected" ]]
}

if [[ ! -f "$jar" ]] || ! verify; then
    mkdir -p "$cache_dir"
    download="${jar}.download.$$"
    trap 'rm -f "$download"' EXIT
    echo "downloading tla2tools.jar ${version} asset ${asset_id}"
    curl -fsSL \
        -H "Accept: application/octet-stream" \
        -o "$download" \
        "https://api.github.com/repos/tlaplus/tlaplus/releases/assets/${asset_id}"
    if ! verify "$download"; then
        echo "error: tla2tools.jar sha256 mismatch against tools/tla/SHA256SUMS" >&2
        exit 1
    fi
    mv "$download" "$jar"
    trap - EXIT
fi

if [[ "$fetch_tool" == true ]]; then
    echo "$jar"
    exit 0
fi

cd "${repo_root}/specs/tla/raft"
echo "running TLC with ${config}"
java_args=(-XX:+UseParallelGC)
if [[ -n "$max_heap" ]]; then
    java_args=("-Xmx${max_heap}" "${java_args[@]}")
fi
tlc_args=(-workers "$workers" -seed "$seed" -fp 0)
if [[ -n "$fp_mem" ]]; then
    tlc_args+=(-fpmem "$fp_mem")
fi
exec java "${java_args[@]}" -cp "$jar" tlc2.TLC \
    "${tlc_args[@]}" -config "$config" "$module"
