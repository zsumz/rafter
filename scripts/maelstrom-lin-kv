#!/usr/bin/env bash
set -euo pipefail

if ! command -v maelstrom >/dev/null 2>&1; then
  echo "maelstrom not found on PATH" >&2
  echo "Install Maelstrom, then rerun this script." >&2
  exit 127
fi
if ! command -v dot >/dev/null 2>&1; then
  echo "Graphviz dot not found on PATH" >&2
  echo "Install Graphviz for Maelstrom analysis, then rerun this script." >&2
  exit 127
fi
if ! command -v gnuplot >/dev/null 2>&1; then
  echo "gnuplot not found on PATH" >&2
  echo "Install Gnuplot for Maelstrom latency graphs, then rerun this script." >&2
  exit 127
fi

ROOT="${RAFTER_MAELSTROM_ROOT:-$(mktemp -d "${TMPDIR:-/tmp}/rafter-maelstrom.XXXXXX")}"
export RAFTER_MAELSTROM_ROOT="$ROOT"

cargo build -p rafter-maelstrom

maelstrom test \
  --workload lin-kv \
  --bin target/debug/rafter-maelstrom \
  --node-count 3 \
  --time-limit 20 \
  --rate 100 \
  --concurrency 6 \
  --nemesis partition \
  --nemesis-interval 1 \
  "$@"
