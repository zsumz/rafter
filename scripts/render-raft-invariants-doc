#!/usr/bin/env python3
"""Render docs/raft-invariants.md from verification/raft-invariants.yaml.

The registry uses a deliberately small YAML subset so this script can stay
dependency-free. Keep scalar values quoted, keep current_coverage as a one-level
map, and keep evidence as a top-level list of scalar fields.
"""

from __future__ import annotations

import argparse
import ast
from collections import Counter
from pathlib import Path
import sys


REPO_ROOT = Path(__file__).resolve().parents[1]
REGISTRY = REPO_ROOT / "verification" / "raft-invariants.yaml"
OUTPUT = REPO_ROOT / "docs" / "raft-invariants.md"

FAMILY_ORDER = [
    ("state", "State Shape"),
    ("election", "Terms, Votes, and Leadership"),
    ("log", "Log Replication"),
    ("commit", "Commitment and Application"),
    ("membership", "Dynamic Membership"),
    ("read", "Read Barriers and Leases"),
    ("persistence", "Persistence, Restart, and Snapshots"),
    ("liveness", "Liveness Obligations"),
]

FAMILY_PURPOSES = {
    "state": "well-formed protocol state and derived indexes",
    "election": "terms, votes, leadership, pre-vote, and authority fencing",
    "log": "leader append-only behavior, append acceptance, and log matching",
    "commit": "commitment, application order, and state-machine safety",
    "membership": "stable and joint configurations, learners, and transfers",
    "read": "ReadIndex, lease reads, apply-before-read, and history checks",
    "persistence": "durability, restart, applied floors, and snapshots",
    "liveness": "bounded progress obligations with explicit assumptions",
}

PREFIX_ORDER = ["ST", "EL", "LG", "CM", "AP", "MB", "RD", "PS", "SS", "LV"]


def parse_scalar(value: str) -> str:
    value = value.strip()
    if not value:
        return ""
    if value[0] in {"'", '"'}:
        return ast.literal_eval(value)
    return value


def parse_registry(
    path: Path,
) -> tuple[dict[str, str], dict[str, int], list[dict[str, str]], list[dict[str, object]]]:
    metadata: dict[str, str] = {}
    counts: dict[str, int] = {}
    evidence: list[dict[str, str]] = []
    invariants: list[dict[str, object]] = []
    current: dict[str, object] | None = None
    current_evidence: dict[str, str] | None = None
    section: str | None = None
    active_map: str | None = None
    in_evidence = False
    in_invariants = False

    for raw_line in path.read_text().splitlines():
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue

        indent = len(raw_line) - len(raw_line.lstrip(" "))
        line = raw_line.strip()

        if indent == 0:
            if current_evidence is not None:
                evidence.append(current_evidence)
                current_evidence = None
            if line == "invariants:":
                in_invariants = True
                in_evidence = False
                section = None
                continue
            if line == "evidence:":
                in_invariants = False
                in_evidence = True
                section = None
                continue
            in_invariants = False
            in_evidence = False
            active_map = None
            if line.endswith(":"):
                section = line[:-1]
                continue
            if ": " in line:
                key, value = line.split(": ", 1)
                metadata[key] = parse_scalar(value)
            continue

        if in_evidence:
            if indent == 2 and line.startswith("- id: "):
                if current_evidence is not None:
                    evidence.append(current_evidence)
                current_evidence = {"id": parse_scalar(line.removeprefix("- id: "))}
                continue
            if indent == 4 and current_evidence is not None and ": " in line:
                key, value = line.split(": ", 1)
                current_evidence[key] = parse_scalar(value)
            continue

        if not in_invariants:
            if section == "counting" and indent == 2 and ": " in line:
                key, value = line.split(": ", 1)
                counts[key] = int(parse_scalar(value))
            continue

        if indent == 2 and line.startswith("- id: "):
            if current is not None:
                invariants.append(current)
            current = {"id": parse_scalar(line.removeprefix("- id: "))}
            active_map = None
            continue

        if current is None:
            continue

        if indent == 4 and line.endswith(":"):
            active_map = line[:-1]
            current[active_map] = {}
            continue

        if indent == 4 and ": " in line:
            key, value = line.split(": ", 1)
            current[key] = parse_scalar(value)
            active_map = None
            continue

        if indent == 6 and active_map and ": " in line:
            key, value = line.split(": ", 1)
            nested = current.setdefault(active_map, {})
            assert isinstance(nested, dict)
            nested[key] = parse_scalar(value)

    if current is not None:
        invariants.append(current)
    if current_evidence is not None:
        evidence.append(current_evidence)

    return metadata, counts, evidence, invariants


def sort_key(entry: dict[str, object]) -> tuple[int, int]:
    invariant_id = str(entry["id"])
    prefix, number = invariant_id.split("-", 1)
    return (PREFIX_ORDER.index(prefix), int(number))


def kind_label(kind: str) -> str:
    return {
        "well_formedness": "well-formedness",
        "safety": "safety",
        "liveness": "liveness",
    }[kind]


def coverage_text(entry: dict[str, object]) -> list[str]:
    coverage = entry["current_coverage"]
    assert isinstance(coverage, dict)
    labels = [
        ("TLA+", "tla"),
        ("Simulator", "simulator"),
        ("Tests", "tests"),
        ("Maelstrom", "maelstrom"),
    ]
    return [f"- {label}: {coverage[key]}" for label, key in labels]


def render_evidence_references(evidence: list[dict[str, str]]) -> list[str]:
    lines = ["| ID | Layer | Strength | Reference |", "| --- | --- | --- | --- |"]
    for record in sorted(evidence, key=evidence_sort_key):
        reference = f"`{record['path']}#{record['symbol']}`"
        if negative := record.get("negative_fixture"):
            reference = f"{reference}; negative fixture `{negative}`"
        lines.append(
            f"| `{record['id']}` | {record['layer']} | {record['strength']} | {reference} |"
        )
    return lines


def evidence_sort_key(record: dict[str, str]) -> tuple[int, int, str, str, str]:
    prefix, number = record["id"].split("-", 1)
    return (
        PREFIX_ORDER.index(prefix),
        int(number),
        record["layer"],
        record["strength"],
        record["path"],
    )


def render_count_table(counts: dict[str, int]) -> list[str]:
    rows = [
        ("Canonical Raft paper safety properties", counts["canonical_raft_safety_properties"]),
        ("Predicates in Rafter's current TLA+ config", counts["tla_predicates_now"]),
        ("Well-formedness meta-invariants", counts["well_formedness_meta_invariants"]),
        ("Semantic safety invariants", counts["semantic_safety_invariants"]),
        ("Liveness obligations", counts["liveness_obligations"]),
        ("Catalog entries", counts["total_entries"]),
    ]
    lines = ["| Scope | Count |", "| --- | ---: |"]
    lines.extend(f"| {label} | {count} |" for label, count in rows)
    return lines


def render_family_map(invariants: list[dict[str, object]]) -> list[str]:
    by_family = Counter(str(entry["family"]) for entry in invariants)
    lines = ["| Family | Entries | Purpose |", "| --- | ---: | --- |"]
    for key, label in FAMILY_ORDER:
        lines.append(f"| {label} | {by_family[key]} | {FAMILY_PURPOSES[key]} |")
    return lines


def render_first_closures(invariants: list[dict[str, object]]) -> list[str]:
    first = [entry for entry in invariants if entry.get("priority") == "p0"]
    lines = [
        "These are the first closures because they turn broad green checks into",
        "named temporal or witness-based verdicts.",
        "",
        "| ID | Work |",
        "| --- | --- |",
    ]
    for entry in sorted(first, key=sort_key):
        lines.append(f"| `{entry['id']}` | {entry['required_action']} |")
    return lines


def render_simple_list(invariants: list[dict[str, object]]) -> list[str]:
    lines = ["| ID | One-line description |", "| --- | --- |"]
    for entry in sorted(invariants, key=sort_key):
        lines.append(f"| `{entry['id']}` | {entry['statement']} |")
    return lines


def render_catalog(invariants: list[dict[str, object]]) -> list[str]:
    lines: list[str] = []
    by_family: dict[str, list[dict[str, object]]] = {key: [] for key, _ in FAMILY_ORDER}
    for entry in sorted(invariants, key=sort_key):
        by_family[str(entry["family"])].append(entry)

    for family, label in FAMILY_ORDER:
        lines.extend([f"### {label}", ""])
        for entry in by_family[family]:
            title = str(entry["title"])
            invariant_id = str(entry["id"])
            kind = kind_label(str(entry["kind"]))
            tier = str(entry["tier"])
            lines.extend(
                [
                    f"#### `{invariant_id}` {title}",
                    "",
                    f"Kind: {kind}. Tier: {tier}.",
                    "",
                    f"Statement: {entry['statement']}",
                    "",
                    "Evidence now:",
                    *coverage_text(entry),
                    "",
                    f"Next: {entry['required_action']}",
                    "",
                ]
            )
    return lines


def render(
    metadata: dict[str, str],
    counts: dict[str, int],
    evidence: list[dict[str, str]],
    invariants: list[dict[str, object]],
) -> str:
    kind_counts = Counter(str(entry["kind"]) for entry in invariants)
    lines: list[str] = [
        "<!-- Generated by scripts/render-raft-invariants-doc from verification/raft-invariants.yaml. -->",
        "",
        "# Raft Invariant Catalog",
        "",
        "This is Rafter's verification contract for one Raft group. It names the",
        "properties the implementation is expected to preserve, where evidence",
        "exists today, and what work would turn partial coverage into a direct",
        "oracle. It is not a claim that Raft has one universal finite invariant",
        "count; the count is meaningful because this registry fixes the scope and",
        "the row granularity.",
        "",
        f"Repository: `{metadata['repository']}`",
        "",
        f"Audited ref: `{metadata['audited_ref']}`",
        "",
        f"Audit date: `{metadata['audit_date']}`",
        "",
        f"Generated from `verification/raft-invariants.yaml`; run `python3 scripts/render-raft-invariants-doc` after editing the registry and `python3 scripts/render-raft-invariants-doc --check` in CI.",
        "",
        "## What This Counts",
        "",
        *render_count_table(counts),
        "",
        "The catalog currently contains "
        f"{kind_counts['well_formedness']} well-formedness row, "
        f"{kind_counts['safety']} safety rows, and "
        f"{kind_counts['liveness']} liveness rows.",
        "",
        "Out of scope: transport encryption, peer authentication, application",
        "snapshot semantics, removed-peer authorization at the deployment boundary,",
        "application state durability above the runtime contract, and multi-group",
        "scheduling properties that are not per-group Raft consensus properties.",
        "",
        "## Evidence Policy",
        "",
        "- Every safety invariant should have at least one direct executable oracle.",
        "- Every canonical safety invariant should have two independent evidence layers.",
        "- Every simulator checker should have a negative fixture proving it can fail.",
        "- Every client-visible invariant should have an end-to-end workload.",
        "- Every persistence invariant should have failure-injection or crash/reopen coverage.",
        "- Every liveness obligation should state its fairness and timing assumptions.",
        "",
        "## Layer Legend",
        "",
        "- D: direct executable oracle.",
        "- P: partial, indirect, or scenario coverage.",
        "- E2E: client-visible end-to-end consequence.",
        "- none: not covered, or not the right layer for that predicate.",
        "",
        "## Family Map",
        "",
        *render_family_map(invariants),
        "",
        "## List",
        "",
        *render_simple_list(invariants),
        "",
        "## First Closures",
        "",
        *render_first_closures(invariants),
        "",
        "## Evidence References",
        "",
        *render_evidence_references(evidence),
        "",
        "## Catalog",
        "",
        *render_catalog(invariants),
    ]
    return "\n".join(lines).rstrip() + "\n"


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Render docs/raft-invariants.md from verification/raft-invariants.yaml.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="fail if docs/raft-invariants.md is not the exact rendered output",
    )
    args = parser.parse_args()
    metadata, counts, evidence, invariants = parse_registry(REGISTRY)
    rendered = render(metadata, counts, evidence, invariants)
    if args.check:
        try:
            current = OUTPUT.read_text()
        except FileNotFoundError:
            print(
                f"{OUTPUT.relative_to(REPO_ROOT)} is missing; run python3 scripts/render-raft-invariants-doc",
                file=sys.stderr,
            )
            raise SystemExit(1) from None
        if current != rendered:
            print(
                f"{OUTPUT.relative_to(REPO_ROOT)} is out of date; run python3 scripts/render-raft-invariants-doc",
                file=sys.stderr,
            )
            raise SystemExit(1)
        return
    OUTPUT.write_text(rendered)


if __name__ == "__main__":
    main()
