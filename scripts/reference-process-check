#!/usr/bin/env bash
# Run every reference consumer's durable process suite against the patched checkout.
#
# Usage:
#   scripts/reference-process-check             # verify each selection, then run it
#   scripts/reference-process-check --list-only # verify each selection only
#
# Each suite is `#[ignore]`d, so `--ignored` on its own reports success over zero
# tests the moment those attributes change. A reviewed inventory in
# verification/ pins which tests each selection contains, and the expected count
# is derived from that same file so the two can never disagree.
set -euo pipefail

usage() {
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

list_only=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --list-only)
            list_only=(--list-only)
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# One entry per consumer that has a durable process suite, as
# `<package>:<test target>:<reviewed inventory>`. Each pair is checked and run
# independently, because `cargo-test-exact` compares one selection against one
# inventory; a shared list could not say which suite a missing name belonged to.
#
# A consumer without a process suite is absent rather than listed with an empty
# inventory: an empty inventory is refused below, and it should be, since a
# selection over zero tests is what this script exists to catch.
suites=(
    "rafter-reference-ledger:process_cluster:reference-process-test-inventory.txt"
    "rafter-reference-fenced-lock:process_cluster:reference-process-test-inventory.fenced-lock.txt"
    "rafter-reference-fenced-lock:process_control_plane:reference-process-test-inventory.fenced-lock-control-plane.txt"
    "rafter-reference-fenced-lock:process_production:reference-process-test-inventory.fenced-lock-production.txt"
    "rafter-reference-sharded-counter:process_cluster:reference-process-test-inventory.sharded-counter.txt"
)

# A process substitution's exit status is not the command's, so the previous
# `while read < <(... --print-args)` form discarded a failing patch table and
# left `patch` empty. An empty patch table does not fail the run: it resolves
# every Rafter dependency from crates.io instead of from this checkout, which
# fails closed only for as long as the versions here are unpublished. Redirect
# to a file instead, so `set -e` sees the real status, and require the result to
# be non-empty.
patch_file="$(mktemp "${TMPDIR:-/tmp}/rafter-reference-patch.XXXXXX")"
trap 'rm -f "$patch_file"' EXIT
"${repo_root}/scripts/reference-source-check" --print-args > "$patch_file"

patch=()
while IFS= read -r argument; do
    [[ -n "$argument" ]] || continue
    patch+=("$argument")
done < "$patch_file"

if (( ${#patch[@]} == 0 )); then
    echo "error: empty dependency patch table; the suites would resolve Rafter from crates.io" >&2
    exit 1
fi

cd "${repo_root}/reference"

for suite in "${suites[@]}"; do
    IFS=: read -r package target inventory_name <<< "$suite"
    inventory="${repo_root}/verification/${inventory_name}"

    if [[ ! -s "$inventory" ]]; then
        echo "error: reviewed process-test inventory is missing or empty: $inventory" >&2
        exit 1
    fi
    expected="$(grep -c . "$inventory")"

    echo "reference process suite: ${package} --test ${target}"
    "${repo_root}/scripts/cargo-test-exact" "$expected" - \
        --inventory "$inventory" "${list_only[@]+"${list_only[@]}"}" \
        "${patch[@]}" -p "$package" \
        --test "$target" -- --ignored
done
