#!/usr/bin/env bash
# Run one replayable real-adapter counter profile and retain its evidence.
set -euo pipefail

usage() {
    echo "usage: scripts/counter-profile <counter-fast|counter-nightly|counter-weekly> [--seed <u64>] [--artifacts <dir>]"
}

if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
fi

profile="$1"
shift
case "$profile" in
    counter-fast | counter-nightly | counter-weekly) ;;
    *)
        echo "error: unknown counter profile: $profile" >&2
        usage >&2
        exit 2
        ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifacts="${repo_root}/artifacts/reference-counter/${profile}"
forward=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --seed)
            [[ $# -ge 2 ]] || {
                echo "error: --seed requires a value" >&2
                exit 2
            }
            forward+=("$1" "$2")
            shift 2
            ;;
        --artifacts)
            [[ $# -ge 2 ]] || {
                echo "error: --artifacts requires a value" >&2
                exit 2
            }
            artifacts="$2"
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

patch_file="$(mktemp "${TMPDIR:-/tmp}/rafter-counter-profile-patch.XXXXXX")"
trap 'rm -f "$patch_file"' EXIT
"${repo_root}/scripts/reference-source-check" --print-args > "$patch_file"

patch=()
while IFS= read -r argument; do
    [[ -n "$argument" ]] || continue
    patch+=("$argument")
done < "$patch_file"

if (( ${#patch[@]} == 0 )); then
    echo "error: empty dependency patch table; the profile would resolve Rafter from crates.io" >&2
    exit 1
fi

# `reference/Cargo.lock` is intentionally untracked, so a clean checkout has
# neither a resolution nor the third-party registry sources needed by the
# offline source-identity run below. Fetch the same patched graph first. This
# keeps every Rafter crate bound to the checkout while making cold CI runners
# independent of an incidental Cargo cache populated by another reference job.
cargo fetch \
    --manifest-path "${repo_root}/reference/Cargo.toml" \
    "${patch[@]}"

CARGO_NET_OFFLINE=true cargo run \
    --manifest-path "${repo_root}/reference/Cargo.toml" \
    "${patch[@]}" \
    -p rafter-reference-sharded-counter \
    --bin counter-profile -- \
    --profile "$profile" \
    --artifacts "$artifacts" \
    ${forward[@]+"${forward[@]}"}
