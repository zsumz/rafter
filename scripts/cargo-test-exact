#!/usr/bin/env bash
# Run a Cargo test selection only when it contains the reviewed number of tests.
#
# Usage:
#   scripts/cargo-test-exact EXPECTED FILTER [--inventory PATH] [--list-only] \
#       [CARGO_ARGS...] [-- LIBTEST_ARGS...]
#
# Use `-` for FILTER when the selection is expressed entirely by Cargo or
# libtest arguments. The inventory and execution commands are otherwise
# identical, apart from the inventory command adding `--list`.
#
# `--list-only` stops after the count and inventory comparison. It exists so a
# selection whose execution is assigned to a slower tier can still have its
# membership checked on every pull request: the drift that silently empties or
# repopulates a selection is visible in the listing, and catching it there costs
# a listing rather than a run.
set -euo pipefail

cargo_command=(cargo)
if [[ -n "${CARGO_TEST_EXACT_TOOLCHAIN:-}" ]]; then
    if [[ ! "$CARGO_TEST_EXACT_TOOLCHAIN" =~ ^\+[A-Za-z0-9._-]+$ ]]; then
        echo "error: CARGO_TEST_EXACT_TOOLCHAIN must be a rustup +toolchain argument" >&2
        exit 2
    fi
    cargo_command+=("$CARGO_TEST_EXACT_TOOLCHAIN")
fi

usage() {
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
}

if [[ $# -lt 2 ]]; then
    usage >&2
    exit 2
fi

expected="$1"
filter="$2"
shift 2

reviewed_inventory=""
list_only=false
while true; do
    case "${1:-}" in
        --inventory)
            if [[ $# -lt 2 ]]; then
                echo "error: --inventory requires a path" >&2
                exit 2
            fi
            reviewed_inventory="$2"
            shift 2
            ;;
        --list-only)
            list_only=true
            shift
            ;;
        *)
            break
            ;;
    esac
done

case "$expected" in
    '' | *[!0-9]*)
        echo "error: EXPECTED must be a positive integer; got '$expected'" >&2
        exit 2
        ;;
esac
if (( expected == 0 )); then
    echo "error: EXPECTED must be greater than zero" >&2
    exit 2
fi

cargo_args=()
libtest_args=()
parsing_libtest=false
for arg in "$@"; do
    if [[ "$arg" == "--" && "$parsing_libtest" == false ]]; then
        parsing_libtest=true
    elif [[ "$parsing_libtest" == true ]]; then
        libtest_args+=("$arg")
    else
        cargo_args+=("$arg")
    fi
done

inventory_file="$(mktemp "${TMPDIR:-/tmp}/rafter-cargo-test-inventory.XXXXXX")"
observed_names="$(mktemp "${TMPDIR:-/tmp}/rafter-cargo-test-names.XXXXXX")"
canonical_names="$(mktemp "${TMPDIR:-/tmp}/rafter-cargo-test-reviewed.XXXXXX")"
trap 'rm -f "$inventory_file" "$observed_names" "$canonical_names"' EXIT

inventory_command=("${cargo_command[@]}" test "${cargo_args[@]}")
if [[ "$filter" != "-" ]]; then
    inventory_command+=("$filter")
fi
inventory_command+=(-- --list)
if (( ${#libtest_args[@]} > 0 )); then
    inventory_command+=("${libtest_args[@]}")
fi

echo "+ ${inventory_command[*]}"
"${inventory_command[@]}" | tee "$inventory_file"

actual="$(awk '/: test$/ { count += 1 } END { print count + 0 }' "$inventory_file")"
if (( actual != expected )); then
    echo "error: Cargo test selection matched $actual tests; expected exactly $expected" >&2
    exit 1
fi

if [[ -n "$reviewed_inventory" ]]; then
    if [[ ! -f "$reviewed_inventory" ]]; then
        echo "error: reviewed test inventory is not a regular file: $reviewed_inventory" >&2
        exit 1
    fi
    awk '/: test$/ { sub(/: test$/, ""); print }' "$inventory_file" | LC_ALL=C sort > "$observed_names"
    LC_ALL=C sort -u "$reviewed_inventory" > "$canonical_names"
    if ! cmp -s "$reviewed_inventory" "$canonical_names"; then
        echo "error: reviewed test inventory must be sorted, unique, and newline-terminated: $reviewed_inventory" >&2
        exit 1
    fi
    if ! cmp -s "$observed_names" "$reviewed_inventory"; then
        echo "error: Cargo test selection differs from reviewed inventory: $reviewed_inventory" >&2
        diff -u "$reviewed_inventory" "$observed_names" >&2 || true
        exit 1
    fi
fi

if [[ "$list_only" == true ]]; then
    if [[ -n "$reviewed_inventory" ]]; then
        echo "selection matches $expected reviewed test names in $reviewed_inventory; not running (--list-only)"
    else
        echo "selection matches $expected tests; not running (--list-only)"
    fi
    exit 0
fi

test_command=("${cargo_command[@]}" test "${cargo_args[@]}")
if [[ "$filter" != "-" ]]; then
    test_command+=("$filter")
fi
test_command+=(--)
if (( ${#libtest_args[@]} > 0 )); then
    test_command+=("${libtest_args[@]}")
fi

echo "+ ${test_command[*]}"
"${test_command[@]}"
