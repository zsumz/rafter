#!/usr/bin/env bash
# Run the reference consumers against exact Rafter package archives.
#
# Usage:
#   scripts/reference-package-check              # full package-consumer lane
#   scripts/reference-package-check --keep       # keep the temporary workdir
#   scripts/reference-package-check --offline    # pass --offline to every cargo call
#   scripts/reference-package-check --no-verify  # compatibility alias; now the default
#   scripts/reference-package-check --mode MODE  # shared exact-package runner
#
# docs/reference-consumers.md defines two dependency modes over one set of
# consumer sources. This script is package-consumer mode: it packages every
# publishable Rafter crate, unpacks the exact archives, patches a copy of the
# reference workspace to those unpacked archives, generates a fresh lockfile,
# builds and runs the consumer tests, and then rejects any graph that reaches
# back into the checkout, pulls an unpublished crate, or turns on an internal
# test hook. It tests the artifact users receive, not the source tree that
# produced it. Fast source mode is a separate lane and lives in
# scripts/reference-source-check; this script never builds a consumer against
# `crates/`.
#
# Why packaging skips Cargo's built-in archive verification:
# the workspace crates depend on each other by version as well as by path.
# Once that version exists on crates.io, Cargo verifies a dependent archive
# against the already-published sibling rather than the sibling archive built
# from this checkout. That can either fail on a newly promoted API or, worse,
# pass without checking the package set together. Phase 5 is the authoritative
# verification: it builds and tests the consumers against nothing but the
# exact unpacked sibling archives.
#
# Network use: every Rafter crate in the consumer graph resolves through
# [patch.crates-io] to an unpacked archive, so none of them is ever fetched.
# The only registry traffic is the index refresh `cargo package` performs and
# the third-party crates a publishable crate depends on (today `fs4`, reached
# through rafter-storage, and its transitive dependencies). Once those are in
# the local Cargo cache the whole lane runs under --offline.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

keep_workdir=false
offline=false
workdir=""
mode=deterministic
artifact_dir=""
msrv_toolchain=1.88
cargo_toolchain=""

usage() {
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --keep)
            keep_workdir=true
            ;;
        --offline)
            offline=true
            ;;
        --no-verify)
            # Archive verification is intentionally disabled for every run.
            # Keep accepting the old explicit flag so existing callers do not break.
            ;;
        --mode)
            if [[ $# -lt 2 ]]; then
                echo "error: --mode requires deterministic, process, msrv, or process-msrv" >&2
                exit 2
            fi
            mode="$2"
            shift
            ;;
        --artifacts)
            if [[ $# -lt 2 ]]; then
                echo "error: --artifacts requires a directory" >&2
                exit 2
            fi
            artifact_dir="$2"
            shift
            ;;
        --msrv-toolchain)
            if [[ $# -lt 2 ]]; then
                echo "error: --msrv-toolchain requires a rustup toolchain name" >&2
                exit 2
            fi
            msrv_toolchain="$2"
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

case "$mode" in
    deterministic | process | msrv | process-msrv) ;;
    *)
        echo "error: unsupported package-check mode: $mode" >&2
        exit 2
        ;;
esac

for tool in cargo jq openssl tar; do
    if ! command -v "$tool" > /dev/null 2>&1; then
        echo "error: $tool is required by scripts/reference-package-check" >&2
        exit 1
    fi
done
if [[ "$mode" == msrv || "$mode" == process-msrv ]]; then
    if ! command -v rustup > /dev/null 2>&1; then
        echo "error: rustup is required for the published-shape MSRV phase" >&2
        exit 1
    fi
    if ! rustup run "$msrv_toolchain" rustc --version > /dev/null 2>&1; then
        echo "error: Rust toolchain $msrv_toolchain is not installed" >&2
        exit 1
    fi
fi

# RELEASE.md's publish list is the complete set of Rafter crates a consumer
# graph can reach, rafter-crc32 included: every crate that a publishable crate
# depends on by version is itself publishable. This script therefore packages
# exactly that list and needs no side list of support crates to package
# alongside it. If a future internal crate becomes a versioned dependency of a
# publishable one without joining the list, phase 1 fails outright: Cargo
# resolves it against crates.io and finds nothing. That loud failure is the
# check; do not paper over it by packaging the crate here.

phase_count=6
phase_name=(
    "package publishable crates"
    "unpack exact archives"
    "verify required archive contents"
    "patch consumer workspace to archives"
    "build and test exact-package consumers"
    "reject checkout paths, private crates, and hooks"
)
case "$mode" in
    process)
        phase_name[4]="build and run exact-package process suites"
        ;;
    msrv)
        phase_name[4]="build and test published shape on Rust $msrv_toolchain"
        ;;
    process-msrv)
        phase_name[4]="run exact-package process and Rust $msrv_toolchain phases"
        ;;
esac
phase_status=(pending pending pending pending pending pending)
current_phase=-1

finding_count=0
findings=()

log() {
    printf '%s\n' "$*"
}

# Command traces go to stderr so that a caller may pipe a command's own output.
run() {
    printf '+ %s\n' "$*" >&2
    "$@"
}

cargo_run() {
    local cargo=(cargo)
    if [[ -n "$cargo_toolchain" ]]; then
        cargo+=("$cargo_toolchain")
    fi
    if [[ "$offline" == true ]]; then
        run "${cargo[@]}" "$1" --offline "${@:2}"
    else
        run "${cargo[@]}" "$@"
    fi
}

add_finding() {
    findings[finding_count]="$1"
    finding_count=$((finding_count + 1))
}

begin_phase() {
    current_phase="$1"
    printf '\n==> phase=%d/%d name=%s\n' \
        "$((current_phase + 1))" "$phase_count" "${phase_name[$current_phase]}"
}

end_phase() {
    phase_status[current_phase]=pass
}

fail() {
    printf 'error: %s\n' "$*" >&2
    if ((current_phase >= 0)); then
        phase_status[current_phase]=fail
    fi
    exit 1
}

print_summary() {
    local status="$1"
    local index

    printf '\n==> summary\n'
    printf '%-3s %-50s %s\n' "#" "phase" "result"
    for ((index = 0; index < phase_count; index++)); do
        printf '%-3s %-50s %s\n' \
            "$((index + 1))" "${phase_name[$index]}" "${phase_status[$index]}"
    done

    if ((finding_count > 0)); then
        printf '\npackage-content findings (reported here, fixed in crates/):\n'
        for ((index = 0; index < finding_count; index++)); do
            printf -- '- %s\n' "${findings[$index]}"
        done
    fi

    printf '\n'
    if ((status == 0)); then
        printf 'reference package-consumer check passed (mode=%s)\n' "$mode"
    else
        printf 'reference package-consumer check failed with status %s (mode=%s)\n' \
            "$status" "$mode" >&2
    fi
}

cleanup() {
    local status=$?
    local index
    local incomplete=false
    trap - EXIT

    # A run that ended before its last phase failed, whatever Bash reports: an
    # aborted expansion or an unset-variable exit must never read as a pass. A
    # phase interrupted by a failing command it did not check itself, such as a
    # cargo error under set -e, is the phase that failed; later phases never ran.
    for ((index = 0; index < phase_count; index++)); do
        if [[ "${phase_status[$index]}" != pass ]]; then
            incomplete=true
            break
        fi
    done
    if [[ "$incomplete" == true ]]; then
        if ((status == 0)); then
            status=1
        fi
        if ((current_phase >= 0)) && [[ "${phase_status[current_phase]}" != pass ]]; then
            phase_status[current_phase]=fail
        fi
        for ((index = current_phase + 1; index < phase_count; index++)); do
            if [[ "${phase_status[$index]}" == pending ]]; then
                phase_status[index]=skipped
            fi
        done
    fi

    print_summary "$status"
    if [[ -n "$workdir" && -d "$workdir" ]]; then
        if ((status == 0)) && [[ "$keep_workdir" == false ]]; then
            rm -rf "$workdir"
        else
            printf 'workdir retained: %s\n' "$workdir"
        fi
    fi
    exit "$status"
}

# RELEASE.md owns both crate lists. Reading them here keeps one authority for
# what is public instead of a second copy that can drift.
release_crate_list() {
    local heading="$1"
    awk -v heading="$heading" '
        index($0, heading) == 1 { wanted = 1; next }
        wanted && /^```/ { if (inside) { exit } ; inside = 1; next }
        inside && NF { print $1 }
    ' "$repo_root/RELEASE.md"
}

# Required package contents.
#
# docs/reference-consumers.md requires this mode to "verify required package
# contents, including README and format documents".
#
# Every publishable archive must carry three files. README.md is what a
# crates.io reader lands on. LICENSE and NOTICE are the terms the archive ships
# under: Cargo packages only files under the crate directory, so the repository
# root's copies never reach an archive on their own and each crate keeps its
# own. RELEASE.md's verification section owns the rule that those per-crate
# copies match the root.
#
# The per-crate entries beyond those three were taken from the crates
# themselves, not guessed: each is a document that the crate's own published
# README links to, so a missing one ships a dead link to a crates.io reader.
#
#   rafter          + ARCHITECTURE.md, STYLE.md
#   rafter-codec    + WIRE_FORMAT_V1.md
#   rafter-storage  + STORAGE_FORMAT_V1.md, DURABILITY_PROTOCOL.md
#   other crates    the three common files only
required_package_files() {
    case "$1" in
        rafter)
            printf 'README.md LICENSE NOTICE ARCHITECTURE.md STYLE.md'
            ;;
        rafter-codec)
            printf 'README.md LICENSE NOTICE WIRE_FORMAT_V1.md'
            ;;
        rafter-storage)
            printf 'README.md LICENSE NOTICE STORAGE_FORMAT_V1.md DURABILITY_PROTOCOL.md'
            ;;
        *)
            printf 'README.md LICENSE NOTICE'
            ;;
    esac
}

if [[ ! -f "$repo_root/RELEASE.md" ]]; then
    fail "RELEASE.md is missing; it owns the publishable crate list"
fi
if [[ ! -f "$repo_root/reference/Cargo.toml" ]]; then
    fail "reference/Cargo.toml is missing; there is no consumer workspace to check"
fi

publish_crates=()
while IFS= read -r crate; do
    [[ -n "$crate" ]] || continue
    publish_crates+=("$crate")
done <<< "$(release_crate_list 'Publish these crates')"

never_publish_crates=()
while IFS= read -r crate; do
    [[ -n "$crate" ]] || continue
    never_publish_crates+=("$crate")
done <<< "$(release_crate_list 'Do not publish these crates')"

if ((${#publish_crates[@]} == 0)); then
    fail "RELEASE.md lists no publishable crates"
fi
if ((${#never_publish_crates[@]} == 0)); then
    fail "RELEASE.md lists no unpublishable crates"
fi

suites=()
if [[ "$mode" == process || "$mode" == process-msrv ]]; then
    suites_file="$repo_root/verification/reference-process-suites.txt"
    if [[ ! -s "$suites_file" ]]; then
        fail "process-suite registry is missing or empty: $suites_file"
    fi
    while IFS= read -r suite; do
        [[ -n "$suite" ]] || continue
        if [[ ! "$suite" =~ ^[a-z0-9-]+:[a-z0-9_]+:[A-Za-z0-9._-]+$ ]]; then
            fail "malformed process-suite registry entry: $suite"
        fi
        IFS=: read -r _package _target inventory_name <<< "$suite"
        if [[ ! -s "$repo_root/verification/$inventory_name" ]]; then
            fail "reviewed process inventory is missing or empty: $inventory_name"
        fi
        suites+=("$suite")
    done < "$suites_file"
    if ((${#suites[@]} == 0)); then
        fail "process-suite registry selected zero suites"
    fi
fi

packaged_crates=("${publish_crates[@]}")
for crate in "${packaged_crates[@]}"; do
    if [[ ! -f "$repo_root/crates/$crate/Cargo.toml" ]]; then
        fail "packaged crate $crate has no manifest under crates/"
    fi
done

log "publishable crates: ${publish_crates[*]}"
log "never-publish crates: ${never_publish_crates[*]}"

if [[ -n "$artifact_dir" ]]; then
    artifact_parent="$(dirname "$artifact_dir")"
    artifact_name="$(basename "$artifact_dir")"
    mkdir -p "$artifact_parent"
    artifact_parent="$(cd "$artifact_parent" && pwd -P)"
    artifact_dir="$artifact_parent/$artifact_name"
    if [[ -d "$artifact_dir" ]] &&
        [[ -n "$(find "$artifact_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
        fail "artifact directory is not empty: $artifact_dir"
    fi
    if [[ -e "$artifact_dir" && ! -d "$artifact_dir" ]]; then
        fail "artifact path is not a directory: $artifact_dir"
    fi
    mkdir -p "$artifact_dir/suite-logs" "$artifact_dir/inventories"
    {
        printf 'package-mode=%s\n' "$mode"
        printf 'packaging-rustc=%s\n' "$(rustc --version)"
        printf 'packaging-cargo=%s\n' "$(cargo --version)"
        if [[ "$mode" == msrv || "$mode" == process-msrv ]]; then
            printf 'msrv-rustc=%s\n' "$(rustup run "$msrv_toolchain" rustc --version)"
            printf 'msrv-cargo=%s\n' "$(rustup run "$msrv_toolchain" cargo --version)"
        fi
    } > "$artifact_dir/toolchain-versions.txt"
    if ((${#suites[@]} > 0)); then
        : > "$artifact_dir/process-suite-counts.txt"
        for suite in "${suites[@]}"; do
            IFS=: read -r package target inventory_name <<< "$suite"
            expected="$(awk 'NF { count += 1 } END { print count + 0 }' \
                "$repo_root/verification/$inventory_name")"
            printf '%s:%s %s %s\n' \
                "$package" "$target" "$expected" "$inventory_name" \
                >> "$artifact_dir/process-suite-counts.txt"
        done
    fi
fi

workdir="$(mktemp -d "${TMPDIR:-/tmp}/rafter-package-check.XXXXXX")"
workdir="$(cd "$workdir" && pwd -P)"
trap cleanup EXIT

# Phase 6 proves that nothing in the consumer graph resolves inside the
# checkout. A workdir under the checkout would make that check meaningless.
case "$workdir/" in
    "$repo_root"/*)
        fail "TMPDIR resolves inside the checkout; set TMPDIR outside $repo_root"
        ;;
esac

log "workdir: $workdir"

package_target="$workdir/package-target"
package_dir="$package_target/package"
unpack_root="$workdir/unpacked"
consumer_root="$workdir/consumer"
consumer_workspace="$consumer_root/reference"
consumer_target="$workdir/consumer-target"

# ---------------------------------------------------------------------------
# Phase 1: package every publishable crate.
# ---------------------------------------------------------------------------
begin_phase 0

package_args=()
for crate in "${packaged_crates[@]}"; do
    package_args+=(-p "$crate")
done
package_args+=(--no-verify)

# --locked keeps the checkout's Cargo.lock exactly as committed; CARGO_TARGET_DIR
# keeps every build artifact inside the workdir. --allow-dirty lets the lane run
# on a working tree, and means the archives describe the tree as it stands
# rather than as it was last committed.
export CARGO_TARGET_DIR="$package_target"
cargo_run package \
    --manifest-path "$repo_root/Cargo.toml" \
    --locked --allow-dirty \
    "${package_args[@]}"

versions_file="$workdir/crate-versions"
cargo_run metadata --format-version 1 --no-deps \
    --manifest-path "$repo_root/Cargo.toml" \
    | jq -r '.packages[] | "\(.name) \(.version)"' > "$versions_file"

end_phase

# ---------------------------------------------------------------------------
# Phase 2: unpack the exact archives. Everything after this point reads only
# from $unpack_root, never from crates/.
# ---------------------------------------------------------------------------
begin_phase 1

mkdir -p "$unpack_root"
hashes_file="$workdir/package-sha256.txt"
: > "$hashes_file"
for crate in "${packaged_crates[@]}"; do
    version="$(awk -v name="$crate" '$1 == name { print $2; exit }' "$versions_file")"
    if [[ -z "$version" ]]; then
        fail "no version for $crate in the root workspace metadata"
    fi

    archive="$package_dir/$crate-$version.crate"
    if [[ ! -f "$archive" ]]; then
        fail "cargo package produced no archive at $archive"
    fi

    digest="$(openssl dgst -sha256 "$archive" | awk '{ print $NF }')"
    entries="$(tar tzf "$archive" | wc -l | tr -d ' ')"
    log "archive=$crate-$version.crate sha256=$digest entries=$entries"
    printf '%s  %s\n' "$digest" "$crate-$version.crate" >> "$hashes_file"

    tar xzf "$archive" -C "$unpack_root"
    if [[ ! -d "$unpack_root/$crate-$version" ]]; then
        fail "archive $crate-$version.crate did not unpack to $crate-$version/"
    fi
done

if [[ -n "$artifact_dir" ]]; then
    cp "$hashes_file" "$artifact_dir/package-sha256.txt"
    cp "$versions_file" "$artifact_dir/crate-versions.txt"
fi

end_phase

# ---------------------------------------------------------------------------
# Phase 3: required archive contents.
# ---------------------------------------------------------------------------
begin_phase 2

contents_failed=false
for crate in "${packaged_crates[@]}"; do
    version="$(awk -v name="$crate" '$1 == name { print $2; exit }' "$versions_file")"
    unpacked="$unpack_root/$crate-$version"

    for required in $(required_package_files "$crate"); do
        if [[ -f "$unpacked/$required" ]]; then
            log "contents ok: $crate-$version/$required"
        else
            printf 'error: %s\n' "$crate-$version.crate is missing required $required" >&2
            contents_failed=true
        fi
    done

    # A crate that declares a readme must ship it, whatever its name. This
    # catches an include/exclude rule that drops the file crates.io renders.
    declared_readme="$(awk -F'"' '/^readme = / { print $2; exit }' "$unpacked/Cargo.toml")"
    if [[ -n "$declared_readme" && ! -f "$unpacked/$declared_readme" ]]; then
        printf 'error: %s\n' "$crate-$version.crate declares readme $declared_readme but does not ship it" >&2
        contents_failed=true
    fi

    # Backstop for the list above, which now requires README.md of every crate:
    # a future per-crate arm that forgets it would silently stop checking, and
    # this reports that. On a passing run it never fires.
    if [[ ! -f "$unpacked/README.md" ]]; then
        add_finding "$crate ships no README.md in its package archive"
    fi
done

if [[ "$contents_failed" == true ]]; then
    fail "one or more package archives are missing required contents"
fi

end_phase

# ---------------------------------------------------------------------------
# Phase 4: patch a copy of the consumer workspace to the unpacked archives.
# ---------------------------------------------------------------------------
begin_phase 3

mkdir -p "$consumer_root"
reference_copy="$workdir/reference-source.tar"
tar -C "$repo_root" \
    --exclude='reference/target' \
    --exclude='reference/Cargo.lock' \
    -cf "$reference_copy" reference
tar -C "$consumer_root" -xf "$reference_copy"
rm -f "$reference_copy"
if [[ -n "$(find "$consumer_workspace" -type l -print -quit)" ]]; then
    fail "copied reference workspace contains a symlink"
fi

# The ledger's dependency_boundary test reads the root workspace manifest three
# directories above itself to assert that the root still excludes reference/.
# Package mode reproduces that layout with a copy, never a symlink or a path
# dependency, so the assertion still has something to read while the consumer
# workspace keeps no live link to the checkout.
cp "$repo_root/Cargo.toml" "$consumer_root/Cargo.toml"

mkdir -p "$consumer_workspace/.cargo"
config_file="$consumer_workspace/.cargo/config.toml"
{
    printf '# Generated by scripts/reference-package-check. Do not commit.\n'
    printf '# Every Rafter crate resolves to an unpacked package archive, so the\n'
    printf '# consumer builds against published artifacts and never against crates/.\n'
    printf '[patch.crates-io]\n'
    for crate in "${packaged_crates[@]}"; do
        version="$(awk -v name="$crate" '$1 == name { print $2; exit }' "$versions_file")"
        printf '%s = { path = "%s" }\n' "$crate" "$unpack_root/$crate-$version"
    done
} > "$config_file"
log "generated $config_file"
cat "$config_file"

tools_root="$workdir/process-tools"
mkdir -p "$tools_root/inventories"
cp "$repo_root/scripts/cargo-test-exact" "$tools_root/cargo-test-exact"
cp "$repo_root/scripts/reference-package-boundary-check" \
    "$tools_root/reference-package-boundary-check"
printf '%s\n' "${never_publish_crates[@]}" > "$tools_root/never-publish-crates.txt"
chmod +x \
    "$tools_root/cargo-test-exact" \
    "$tools_root/reference-package-boundary-check"
if [[ "$mode" == process || "$mode" == process-msrv ]]; then
    cp "$repo_root/verification/reference-process-suites.txt" "$tools_root/reference-process-suites.txt"
    for suite in "${suites[@]}"; do
        IFS=: read -r _package _target inventory_name <<< "$suite"
        cp "$repo_root/verification/$inventory_name" "$tools_root/inventories/$inventory_name"
        if [[ -n "$artifact_dir" ]]; then
            cp "$repo_root/verification/$inventory_name" "$artifact_dir/inventories/$inventory_name"
        fi
    done
fi
if [[ "$mode" == msrv || "$mode" == process-msrv ]]; then
    smoke_inventory_name="reference-package-msrv-process-smoke-inventory.txt"
    smoke_inventory="$repo_root/verification/$smoke_inventory_name"
    if [[ ! -s "$smoke_inventory" ]]; then
        fail "published-shape process smoke inventory is missing or empty"
    fi
    cp "$smoke_inventory" "$tools_root/inventories/$smoke_inventory_name"
    if [[ -n "$artifact_dir" ]]; then
        cp "$smoke_inventory" "$artifact_dir/inventories/$smoke_inventory_name"
    fi
fi

if [[ -n "$artifact_dir" ]]; then
    cp "$config_file" "$artifact_dir/patch-table.toml"
fi

cd "$consumer_workspace"
export CARGO_TARGET_DIR="$consumer_target"

if [[ "$mode" == msrv ]]; then
    cargo_toolchain="+$msrv_toolchain"
fi

# Cargo warns about patch entries a consumer does not reach yet. That is the
# expected shape while the portfolio is one consumer wide, and phase 6 is what
# proves the entries that are used point at archives.
log "note: unused [patch] warnings are expected until every Rafter crate has a consumer"
cargo_run generate-lockfile

if [[ ! -f "$consumer_workspace/Cargo.lock" ]]; then
    fail "cargo generate-lockfile produced no consumer lockfile"
fi
# Only [[package]] blocks: a lockfile also carries the format version and a
# [[patch.unused]] block for every patch entry this consumer does not reach.
log "consumer lockfile packages:"
awk -F'"' '
    /^\[\[package\]\]/ { in_package = 1; next }
    /^\[/ { in_package = 0 }
    in_package && /^name = / { name = $2 }
    in_package && /^version = / { printf "  %s %s\n", name, $2 }
' "$consumer_workspace/Cargo.lock"
if [[ -n "$artifact_dir" ]]; then
    cp "$consumer_workspace/Cargo.lock" "$artifact_dir/Cargo.lock"
fi

end_phase

# ---------------------------------------------------------------------------
# Phase 5: build and test the consumers against the archives.
# ---------------------------------------------------------------------------
begin_phase 4

process_log_root="$workdir/suite-logs"
if [[ -n "$artifact_dir" ]]; then
    process_log_root="$artifact_dir/suite-logs"
fi
mkdir -p "$process_log_root"

run_reviewed_process_suites() {
    local suite package target inventory_name inventory expected log_file
    local exact_cargo_args=(--locked)
    if [[ "$offline" == true ]]; then
        exact_cargo_args+=(--offline)
    fi

    cargo_run build --workspace --all-targets --locked
    for suite in "${suites[@]}"; do
        IFS=: read -r package target inventory_name <<< "$suite"
        inventory="$tools_root/inventories/$inventory_name"
        expected="$(awk 'NF { count += 1 } END { print count + 0 }' "$inventory")"
        if ((expected == 0)); then
            fail "reviewed process inventory selected zero tests: $inventory_name"
        fi
        log_file="$process_log_root/${package}-${target}.log"
        log "exact-package process suite: $package --test $target ($expected reviewed tests)"
        CARGO_TEST_EXACT_TOOLCHAIN="$cargo_toolchain" \
            "$tools_root/cargo-test-exact" "$expected" - \
            --inventory "$inventory" \
            "${exact_cargo_args[@]}" -p "$package" \
            --test "$target" -- --ignored --test-threads=1 \
            2>&1 | tee "$log_file"
    done
}

run_msrv_shape() {
    local previous_target="$CARGO_TARGET_DIR"
    local smoke_inventory="$tools_root/inventories/$smoke_inventory_name"
    local smoke_expected
    local exact_cargo_args=(--locked)
    if [[ "$offline" == true ]]; then
        exact_cargo_args+=(--offline)
    fi

    cargo_toolchain="+$msrv_toolchain"
    export CARGO_TARGET_DIR="$workdir/msrv-target"
    rm -f "$consumer_workspace/Cargo.lock"
    cargo_run generate-lockfile
    if [[ -n "$artifact_dir" ]]; then
        cp "$consumer_workspace/Cargo.lock" "$artifact_dir/Cargo.msrv.lock"
    fi

    cargo_run build --workspace --all-targets --locked
    cargo_run test --workspace --locked

    smoke_expected="$(awk 'NF { count += 1 } END { print count + 0 }' "$smoke_inventory")"
    if ((smoke_expected == 0)); then
        fail "published-shape process smoke inventory selected zero tests"
    fi
    CARGO_TEST_EXACT_TOOLCHAIN="$cargo_toolchain" \
        "$tools_root/cargo-test-exact" "$smoke_expected" \
        "three_processes_elect_a_leader_and_serve_the_ledger" \
        --inventory "$smoke_inventory" \
        "${exact_cargo_args[@]}" -p rafter-reference-ledger \
        --test process_cluster -- --ignored --test-threads=1 \
        2>&1 | tee "$process_log_root/msrv-process-smoke.log"
    export CARGO_TARGET_DIR="$previous_target"
}

case "$mode" in
    deterministic)
        cargo_run build --workspace --all-targets --locked
        cargo_run test --workspace --locked
        cargo_run run --locked -p rafter-reference-sharded-counter --bin counter-profile -- \
            --profile counter-fast \
            --artifacts "$workdir/counter-fast-package-artifacts"
        ;;
    process)
        run_reviewed_process_suites
        ;;
    msrv)
        # Phase 4 already switched lockfile generation to the MSRV toolchain.
        cargo_run build --workspace --all-targets --locked
        cargo_run test --workspace --locked
        smoke_expected="$(awk 'NF { count += 1 } END { print count + 0 }' \
            "$tools_root/inventories/$smoke_inventory_name")"
        exact_cargo_args=(--locked)
        if [[ "$offline" == true ]]; then
            exact_cargo_args+=(--offline)
        fi
        CARGO_TEST_EXACT_TOOLCHAIN="$cargo_toolchain" \
            "$tools_root/cargo-test-exact" "$smoke_expected" \
            "three_processes_elect_a_leader_and_serve_the_ledger" \
            --inventory "$tools_root/inventories/$smoke_inventory_name" \
            "${exact_cargo_args[@]}" -p rafter-reference-ledger \
            --test process_cluster -- --ignored --test-threads=1 \
            2>&1 | tee "$process_log_root/msrv-process-smoke.log"
        ;;
    process-msrv)
        run_reviewed_process_suites
        run_msrv_shape
        ;;
esac

end_phase

# ---------------------------------------------------------------------------
# Phase 6: reject checkout paths, unpublished crates, and internal hooks.
# ---------------------------------------------------------------------------
begin_phase 5

metadata_file="$workdir/consumer-metadata.json"
cargo_run metadata --format-version 1 --locked > "$metadata_file"
if [[ -n "$artifact_dir" ]]; then
    cp "$metadata_file" "$artifact_dir/consumer-metadata.json"
fi

if ! "$tools_root/reference-package-boundary-check" \
    --metadata "$metadata_file" \
    --checkout-root "$repo_root" \
    --unpack-root "$unpack_root" \
    --consumer-workspace "$consumer_workspace" \
    --harness-path "$consumer_workspace/harness" \
    --never-publish-file "$tools_root/never-publish-crates.txt"; then
    fail "the consumer graph violates the package-consumer boundary"
fi
if [[ -n "$artifact_dir" ]]; then
    {
        printf 'checkout-paths=none\n'
        printf 'forbidden-path-dependencies=none\n'
        printf 'unpublished-crates=none\n'
        printf 'internal-test-hooks=none\n'
        printf 'rafter-source-root=%s\n' "$unpack_root"
    } > "$artifact_dir/metadata-boundary.txt"
fi

resolved_archives="$(jq -r --arg unpacked "$unpack_root/" '
    .packages[]
    | select(.manifest_path | startswith($unpacked))
    | "  \(.name) \(.version) <- \(.manifest_path)"
' "$metadata_file")"
if [[ -n "$resolved_archives" ]]; then
    log "Rafter crates resolved from archives:"
    log "$resolved_archives"
else
    log "note: the consumers declare no Rafter dependency yet, so every [patch]"
    log "      entry is unused. The rejections above still hold, and they bind as"
    log "      soon as a consumer manifest names a versioned Rafter crate."
fi

end_phase
