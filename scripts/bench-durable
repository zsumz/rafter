#!/usr/bin/env python3
"""Run fixed durable workloads in isolated processes and preserve every sample."""

import argparse
import datetime
import hashlib
import json
import math
import os
from pathlib import Path
import platform
import resource
import statistics
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]


def save(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def cpu_stat():
    path = Path("/proc/stat")
    return path.read_text() if path.exists() else None


def metric(value, label, *, positive=False):
    """Accept JSON numbers only; bool and numeric-looking strings are not metrics."""
    try:
        finite = type(value) in (int, float) and math.isfinite(value)
    except OverflowError:
        finite = False
    if not finite or value < 0 or (positive and value == 0):
        raise ValueError(f"{label} must be a finite {'positive' if positive else 'nonnegative'} number")
    return value


def finite_metrics(value):
    if isinstance(value, dict):
        for item in value.values():
            finite_metrics(item)
    elif isinstance(value, list):
        for item in value:
            finite_metrics(item)
    elif type(value) in (int, float):
        metric(value, "benchmark metric")


def latency(summary, expected_samples, elapsed, label):
    if not isinstance(summary, dict):
        raise ValueError(f"missing {label} summary")
    if type(summary.get("samples")) is not int or summary["samples"] != expected_samples:
        raise ValueError(f"{label} sample count differs from the workload")
    p50, p99, maximum = [metric(summary.get(key), f"{label}.{key}")
                         for key in ("p50", "p99", "max")]
    if not p50 <= p99 <= maximum <= elapsed:
        raise ValueError(f"{label} percentiles must be ordered and within workload elapsed time")


def throughput(value, units, elapsed, label):
    rate = metric(value, label)
    # The Rust reporter rounds both milliseconds and rates to three decimals.
    # Compare the possible intervals, not the ratio of the rounded values.
    rounding = 0.0005
    low = units * 1000 / (elapsed + rounding)
    high = math.inf if elapsed <= rounding else units * 1000 / (elapsed - rounding)
    if rate + rounding < low and not math.isclose(rate + rounding, low, rel_tol=1e-12):
        raise ValueError(f"{label} disagrees with workload count and elapsed time")
    if rate - rounding > high and not math.isclose(rate - rounding, high, rel_tol=1e-12):
        raise ValueError(f"{label} disagrees with workload count and elapsed time")


def validate(report, case, batches, snapshot_bytes, hard_state=None):
    if not isinstance(report, dict):
        raise ValueError("expected a durable workload report")
    if hard_state is not None and report.get("hard_state") != hard_state:
        raise ValueError("reported hard-state backend differs from the requested backend")
    workloads = report.get("workloads")
    if (report.get("harness") != "rafter-bench-cluster" or not isinstance(workloads, list)
            or len(workloads) != 1 or not isinstance(workloads[0], dict)):
        raise ValueError("expected exactly one durable workload report")
    workload = workloads[0]
    finite_metrics(workload)
    if case == "snapshot":
        expected = {"name": "snapshot_transfer", "payload_bytes": snapshot_bytes}
    else:
        batch = int(case.removeprefix("batch-"))
        expected = {"name": "proposals", "batch_size": batch, "proposals": batch * batches,
                    "payload_bytes": 256, "proposal_batches": batches}
    if any(type(workload.get(key)) is not type(value) or workload[key] != value
           for key, value in expected.items()):
        raise ValueError(f"workload shape differs from requested case: {case}")
    elapsed = metric(workload.get("elapsed_ms"), "elapsed_ms", positive=True)
    if case == "snapshot":
        metric(workload.get("preparation_ms"), "preparation_ms")
        throughput(workload.get("throughput_mib_per_s"), snapshot_bytes / (1024 * 1024),
                   elapsed, "throughput_mib_per_s")
    else:
        throughput(workload.get("proposals_per_s"), batch * batches, elapsed, "proposals_per_s")
        latency(workload.get("commit_latency_ms"), batch * batches, elapsed, "commit latency")
        latency(workload.get("batch_completion_latency_ms"), batches, elapsed, "batch latency")
        phases = workload.get("phase_ms")
        if not isinstance(phases, dict):
            raise ValueError("missing phase timing summary")
        phase_sum = sum(metric(phases.get(key), f"phase_ms.{key}")
                        for key in ("leader_steps", "message_pumps"))
        # Two phase values and the elapsed value are independently rounded.
        if phase_sum > elapsed + 0.0015:
            raise ValueError("phase timings exceed workload elapsed time")
    return workload


def aggregate(samples):
    first = samples[0]
    if isinstance(first, dict):
        if any(sample.keys() != first.keys() for sample in samples):
            raise ValueError("inconsistent benchmark fields")
        return {key: aggregate([sample[key] for sample in samples]) for key in first}
    if isinstance(first, (int, float)):
        return statistics.median(samples)
    if any(sample != first for sample in samples):
        raise ValueError("inconsistent benchmark identities")
    return first


def run_sample(binary, case, args, out, label, hard_state=None):
    command = [str(binary), "--directory", str(args.directory)]
    if hard_state is not None:
        command += ["--hard-state", hard_state]
    if case == "snapshot":
        command += ["--workload", "snapshot", "--snapshot-bytes", str(args.snapshot_bytes)]
    else:
        batch = int(case.removeprefix("batch-"))
        command += ["--workload", "proposals", "--proposals", str(batch * args.batches),
                    "--batch-sizes", str(batch)]
    before = resource.getrusage(resource.RUSAGE_CHILDREN)
    started = time.monotonic()
    before_cpu = cpu_stat()
    timeout = None
    launch_error = None
    with (out / f"{label}.json").open("w") as stdout, (out / f"{label}.stderr").open("w") as stderr:
        try:
            result = subprocess.run(command, stdout=stdout, stderr=stderr, timeout=args.timeout)
            exit_code = result.returncode
        except subprocess.TimeoutExpired as error:
            timeout = error
            exit_code = None
        except OSError as error:
            launch_error = error
            exit_code = None
    elapsed = time.monotonic() - started
    after = resource.getrusage(resource.RUSAGE_CHILDREN)
    execution = {"command": command, "exit_code": exit_code, "timed_out": timeout is not None,
                 "wall_seconds": elapsed,
                 "user_seconds": after.ru_utime - before.ru_utime,
                 "system_seconds": after.ru_stime - before.ru_stime,
                 "proc_stat_before": before_cpu, "proc_stat_after": cpu_stat()}
    if launch_error is not None:
        execution["launch_error"] = {"type": type(launch_error).__name__,
                                     "errno": launch_error.errno, "message": str(launch_error)}
    save(out / f"{label}.execution.json", execution)
    if timeout:
        raise timeout
    if launch_error is not None:
        raise launch_error
    result.check_returncode()
    return validate(json.loads((out / f"{label}.json").read_text()), case, args.batches, args.snapshot_bytes, hard_state)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    target = Path(os.environ.get("CARGO_TARGET_DIR", ROOT / "bench-compare/target"))
    parser.add_argument("--binary", type=Path, default=target / "release/bench-rafter-durable")
    parser.add_argument("--baseline", type=Path, help="optional baseline for alternating A/B runs")
    parser.add_argument("--hard-state", choices=["replace", "journal"])
    parser.add_argument("--baseline-hard-state", choices=["replace", "journal"])
    parser.add_argument("--output", type=Path)
    parser.add_argument("--directory", type=Path, default=Path(os.environ.get("TMPDIR", "/tmp")))
    parser.add_argument("--runs", type=positive, default=4)
    parser.add_argument("--batches", type=positive, default=2048)
    parser.add_argument("--snapshot-bytes", type=positive, default=128 * 1024 * 1024)
    parser.add_argument("--timeout", type=positive, default=300)
    args = parser.parse_args()
    if not 1000 <= args.batches <= 8192 or args.runs < 3:
        parser.error("evidence requires 1000..8192 batches and at least three runs")
    if args.snapshot_bytes > 1024 * 1024 * 1024:
        parser.error("snapshot bytes must not exceed 1 GiB")
    args.directory = args.directory.resolve(strict=True)
    if not args.directory.is_dir():
        parser.error("--directory must name an existing directory")
    binaries = {"candidate" if args.baseline else "current": args.binary.resolve(strict=True)}
    if args.baseline:
        binaries = {"baseline": args.baseline.resolve(strict=True), **binaries}
    backends = {arm: args.baseline_hard_state if arm == "baseline" else args.hard_state
                for arm in binaries}
    timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    out = args.output or ROOT / "target/bench-durable" / timestamp
    out.mkdir(parents=True, exist_ok=False)
    save(out / "metadata.json", {
        "started_at_utc": timestamp, "machine": platform.uname()._asdict(),
        "cpu_affinity": sorted(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else None,
        "commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
        "binaries": {name: {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
                     for name, path in binaries.items()},
        "hard_state": backends, "runs": args.runs, "batches": args.batches, "snapshot_bytes": args.snapshot_bytes,
        "scratch_parent": str(args.directory),
        "aggregation": "Median of run metrics, including each run percentile; no pooled percentiles.",
    })
    cases = ["batch-1", "batch-8", "batch-32", "batch-128", "snapshot"]
    samples = {arm: {case: [] for case in cases} for arm in binaries}
    order = []
    for run in range(args.runs):
        arms = list(binaries) if run % 2 == 0 else list(reversed(binaries))
        rotated = cases[run % len(cases):] + cases[:run % len(cases)]
        for case in rotated:
            for arm in arms:
                label = f"run-{run + 1}-{case}-{arm}"
                print(label, flush=True)
                order.append(label)
                save(out / "execution-order.json", order)
                samples[arm][case].append(run_sample(binaries[arm], case, args, out, label, backends[arm]))
    results = {}
    for arm, workloads in samples.items():
        results[arm] = {}
        for case, values in workloads.items():
            rate = "throughput_mib_per_s" if case == "snapshot" else "proposals_per_s"
            results[arm][case] = {"median": aggregate(values), "rate": rate,
                                  "rate_min": min(value[rate] for value in values),
                                  "rate_max": max(value[rate] for value in values)}
    save(out / "results.json", {"runs": args.runs, "results": results})
    print(f"Evidence: {out}", flush=True)


if __name__ == "__main__":
    main()
